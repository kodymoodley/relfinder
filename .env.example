# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real credentials.

# Required when using the CORS proxy:
# Scheme + host of the SPARQL endpoint — no path component.
SPARQL_HOST=https://your-endpoint.example.com

# Optional: path at that host. Defaults to /sparql.
# Change this if your endpoint uses a different path, e.g. /mydb/sparql.
# SPARQL_PATH=/sparql

# Optional: restrict CORS to your frontend origin.
# Defaults to * (all origins) which is fine for local development.
ALLOWED_ORIGIN=http://localhost:5173
