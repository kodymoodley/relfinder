:sicario          rdf:type :Movie ; :hasTitle "Sicario"                 ; :hasYear 2015 .
:prisoners        rdf:type :Movie ; :hasTitle "Prisoners"               ; :hasYear 2013 .

:1917             rdf:type :Movie ; :hasTitle "1917"                    ; :hasYear 2019 .
:skyfall          rdf:type :Movie ; :hasTitle "Skyfall"                 ; :hasYear 2012 .
:road_to_perdition rdf:type :Movie ; :hasTitle "Road to Perdition"      ; :hasYear 2002 .

