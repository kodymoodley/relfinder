@prefix : <http://filmgraph.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .

# -----------------------------------------------------------------------
# ONTOLOGY — roles & properties
# -----------------------------------------------------------------------

:Person       rdf:type owl:Class .
:Movie        rdf:type owl:Class .
:Actor        rdf:type owl:Class ; rdfs:subClassOf :Person .
:Actress      rdf:type owl:Class ; rdfs:subClassOf :Person .
:Director     rdf:type owl:Class ; rdfs:subClassOf :Person .
:DP           rdf:type owl:Class ; rdfs:subClassOf :Person .   # Director of Photography
:Editor       rdf:type owl:Class ; rdfs:subClassOf :Person .
:Composer     rdf:type owl:Class ; rdfs:subClassOf :Person .

:actedIn      rdf:type owl:ObjectProperty ; rdfs:domain :Person   ; rdfs:range :Movie .
:directed     rdf:type owl:ObjectProperty ; rdfs:domain :Director ; rdfs:range :Movie .
:shotBy       rdf:type owl:ObjectProperty ; rdfs:domain :Movie    ; rdfs:range :DP .
:editedBy     rdf:type owl:ObjectProperty ; rdfs:domain :Movie    ; rdfs:range :Editor .
:scoredBy     rdf:type owl:ObjectProperty ; rdfs:domain :Movie    ; rdfs:range :Composer .
:playedRole   rdf:type owl:DatatypeProperty ; rdfs:domain :Person ; rdfs:range xsd:string .
:hasTitle     rdf:type owl:DatatypeProperty ; rdfs:domain :Movie  ; rdfs:range xsd:string .
:hasYear      rdf:type owl:DatatypeProperty ; rdfs:domain :Movie  ; rdfs:range xsd:integer .
:hasName      rdf:type owl:DatatypeProperty ; rdfs:domain :Person ; rdfs:range xsd:string .
:hasNationality rdf:type owl:DatatypeProperty ; rdfs:domain :Person ; rdfs:range xsd:string .
:workedWith   rdf:type owl:ObjectProperty ; rdfs:domain :Person   ; rdfs:range :Person .

# -----------------------------------------------------------------------
# DIRECTORS
# -----------------------------------------------------------------------

:nolan        rdf:type :Director ; :hasName "Christopher Nolan" ; :hasNationality "British-American" .
:fincher      rdf:type :Director ; :hasName "David Fincher"     ; :hasNationality "American" .
:villeneuve   rdf:type :Director ; :hasName "Denis Villeneuve"  ; :hasNationality "Canadian" .
:mendes       rdf:type :Director ; :hasName "Sam Mendes"        ; :hasNationality "British" .
:iannucci     rdf:type :Director ; :hasName "Armando Iannucci"  ; :hasNationality "British" .

# -----------------------------------------------------------------------
# DIRECTORS OF PHOTOGRAPHY
# -----------------------------------------------------------------------

:pfister      rdf:type :DP ; :hasName "Wally Pfister"       ; :hasNationality "American" .
:deakins      rdf:type :DP ; :hasName "Roger Deakins"       ; :hasNationality "British" .
:khondji      rdf:type :DP ; :hasName "Darius Khondji"      ; :hasNationality "French-Iranian" .
:van_hoytema  rdf:type :DP ; :hasName "Hoyte van Hoytema"   ; :hasNationality "Dutch-Swedish" .
:muro         rdf:type :DP ; :hasName "James Muro"          ; :hasNationality "American" .

# -----------------------------------------------------------------------
# EDITORS
# -----------------------------------------------------------------------

:lee_smith    rdf:type :Editor ; :hasName "Lee Smith"        ; :hasNationality "Australian" .
:kirk_baxter  rdf:type :Editor ; :hasName "Kirk Baxter"      ; :hasNationality "Australian" .
:angus_wall   rdf:type :Editor ; :hasName "Angus Wall"       ; :hasNationality "American" .
:pietro_scalia rdf:type :Editor ; :hasName "Pietro Scalia"   ; :hasNationality "Italian-American" .

# -----------------------------------------------------------------------
# COMPOSERS
# -----------------------------------------------------------------------

:zimmer       rdf:type :Composer ; :hasName "Hans Zimmer"    ; :hasNationality "German-American" .
:reznor       rdf:type :Composer ; :hasName "Trent Reznor"   ; :hasNationality "American" .
:atticus_ross rdf:type :Composer ; :hasName "Atticus Ross"   ; :hasNationality "British" .
:goransson    rdf:type :Composer ; :hasName "Ludwig Göransson" ; :hasNationality "Swedish" .

# -----------------------------------------------------------------------
# ACTORS & ACTRESSES
# -----------------------------------------------------------------------

:bale         rdf:type :Actor   ; :hasName "Christian Bale"   ; :hasNationality "Welsh-American" .
