:se7en            rdf:type :Movie ; :hasTitle "Se7en"                   ; :hasYear 1995 .
:gone_girl        rdf:type :Movie ; :hasTitle "Gone Girl"               ; :hasYear 2014 .
:social_network   rdf:type :Movie ; :hasTitle "The Social Network"      ; :hasYear 2010 .
:girl_dragon      rdf:type :Movie ; :hasTitle "The Girl with the Dragon Tattoo" ; :hasYear 2011 .
:mank             rdf:type :Movie ; :hasTitle "Mank"                    ; :hasYear 2020 .

:arrival          rdf:type :Movie ; :hasTitle "Arrival"                 ; :hasYear 2016 .
:blade_runner     rdf:type :Movie ; :hasTitle "Blade Runner 2049"       ; :hasYear 2017 .
:dune             rdf:type :Movie ; :hasTitle "Dune"                    ; :hasYear 2021 .
