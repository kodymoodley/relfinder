:ferguson     rdf:type :Actress ; :hasName "Rebecca Ferguson"  ; :hasNationality "Swedish" .
:hathaway     rdf:type :Actress ; :hasName "Anne Hathaway"    ; :hasNationality "American" .
:cotillard    rdf:type :Actress ; :hasName "Marion Cotillard" ; :hasNationality "French" .
:zendaya      rdf:type :Actress ; :hasName "Zendaya"          ; :hasNationality "American" .
:knightley    rdf:type :Actress ; :hasName "Keira Knightley"  ; :hasNationality "British" .

# -----------------------------------------------------------------------
# MOVIES
# -----------------------------------------------------------------------

:dark_knight      rdf:type :Movie ; :hasTitle "The Dark Knight"         ; :hasYear 2008 .
:dark_knight_rises rdf:type :Movie ; :hasTitle "The Dark Knight Rises"  ; :hasYear 2012 .
:inception        rdf:type :Movie ; :hasTitle "Inception"               ; :hasYear 2010 .
