# ── Software projects ─────────────────────────────────────────────────────────
:VSCode
  rdf:type :Framework ;
  rdfs:label "Visual Studio Code"@en ;
  rdfs:label "Visual Studio Code"@de ;
  rdfs:label "Visual Studio Code"@fr ;
  dc:title "Visual Studio Code" ;
  :firstRelease "2015"^^xsd:gYear ;
  :latestVersion "1.89.0" ;
  :githubStars "160000"^^xsd:nonNegativeInteger ;
  :contributorCount "1800"^^xsd:nonNegativeInteger ;
  :writtenIn :TypeScript ;
  :licensedUnder :MIT_License ;
  :sponsoredBy :Microsoft ;
  :createdBy :AndersH ;
  dct:description "Free source-code editor with IntelliSense and debugging support."@en ;
  dct:description "Kostenloser Quellcode-Editor mit IntelliSense."@de .

