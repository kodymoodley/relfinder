# =============================================================================
# Achmea ontology - merged TriG
# Generated by merging 13 source .trig files from ontology.zip into one file.
# Content is grouped into the two named graphs used across the sources:
#   graph:ontology  (core, domain, provenance, ontology metadata)
#   graph:shacl     (SHACL logic / validation shapes)
# Prefix declarations were de-duplicated into the single header below.
# =============================================================================

@prefix dcterms:  <http://purl.org/dc/terms/> .
@prefix owl:      <http://www.w3.org/2002/07/owl#> .
@prefix prov:     <http://www.w3.org/ns/prov#> .
@prefix rdf:      <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:       <http://www.w3.org/ns/shacl#> .
@prefix skos:     <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .
@prefix def:      <https://data.achmea.nl/def/> .
@prefix admin:    <https://data.achmea.nl/def/admin/> .
@prefix pdc:      <https://data.achmea.nl/def/pdc/> .
@prefix pds:      <https://data.achmea.nl/def/pds/> .
@prefix products: <https://data.achmea.nl/def/products/> .
@prefix prv:      <https://data.achmea.nl/def/provenance/> .
@prefix services: <https://data.achmea.nl/def/services/> .
@prefix graph:    <https://data.achmea.nl/graph/> .
@prefix shp:      <https://data.achmea.nl/shp/> .


# #############################################################################
# ONTOLOGY GRAPH  <https://data.achmea.nl/graph/ontology>
# #############################################################################

graph:ontology {

# ----------------------------------------------------------------------------
# source: ontology/main.trig
# ----------------------------------------------------------------------------
### Namespace for graphs
### Custom Namespaces (Achmea)

def:
    a owl:Ontology ;
    dcterms:title "Achmea ontology"@en ;
    owl:versionInfo "1.0.0" ;
    owl:versionIRI <https://data.achmea.nl/def/1.0.0/> ;
    rdfs:label
        "Vocabulary for product/service graph and regulation graph of Achmea."@en,
        "Vocabulaire voor product/dienstengraaf en wetgraaf van Achmea."@nl;
    rdfs:comment
        "Vocabulary for product/service graph and regulation graph of Achmea."@en,
        "Vocabulaire voor product/dienstengraaf en wetgraaf van Achmea."@nl;
    dcterms:created "2025-12-30"^^xsd:date ;
    owl:imports
        <https://data.achmea.nl/def/core> ,
        <https://data.achmea.nl/def/pdc> ,
        <https://data.achmea.nl/def/pds> ,
        <https://data.achmea.nl/def/services> ,
        <https://data.achmea.nl/def/provenance> ,
        <https://data.achmea.nl/def/admin> ,
        <https://data.achmea.nl/def/shacl/logic_admin> ,
        <https://data.achmea.nl/def/shacl/logic_core> ,
        <https://data.achmea.nl/def/shacl/logic_pdc> ,
        <https://data.achmea.nl/def/shacl/logic_pds> ,
        <https://data.achmea.nl/def/shacl/logic_prov> .

# ----------------------------------------------------------------------------
# source: ontology/core/core.trig
# ----------------------------------------------------------------------------
### Open Standard Vocabularies
### Custom Namespaces (Achmea)
### Ontology Metadata
def:core
    a owl:Ontology ;
    dcterms:title "Achmea core ontology"@en ;
    dcterms:created "2025-12-30"^^xsd:date ;
    owl:versionIRI <https://data.achmea.nl/def/core/1.0.0/> ;
    rdfs:comment "Core definitions for Achmea data ecosystem."@en .

# ========================================
# Core Ontology
# ========================================

# These are general purpose properties used across multiple domain ontologies.
# Make sure the description SCHACL is at low severity (as almost everything is missing description)
def:description a owl:DatatypeProperty ;
    rdfs:label "description"@en, "beschrijving"@nl ;
    rdfs:comment
        "A human-readable description of the entity."@en ,
        "Een leesbare beschrijving van de entiteit."@nl ;
    rdfs:domain prov:Entity, prov:Activity, prov:Agent ;
    rdfs:range rdf:langString .

def:identifier a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:label "identifier"@en, "identificatie"@nl ;
    rdfs:comment
        "A unique identifier label, such as AP060."@en ,
        "Een uniek identificatie label, zoals AP060."@nl ;
    rdfs:domain products:Product, products:ProductPackage, products:ProductChoice, services:Service;
    rdfs:range xsd:string .

def:label a owl:DatatypeProperty ;
    rdfs:label "has label"@en, "heeft label"@nl ;
    rdfs:domain prov:Entity, prov:Activity, prov:Agent ;
    rdfs:range rdf:langString ;
    rdfs:subPropertyOf rdfs:label .

# ========================================
# Test Metadata Properties
# ========================================
# These properties are used in test files to annotate expected SHACL validation outcomes.
# They are declared as ObjectProperty to allow SHACL validators to recognize them as valid predicates.

def:conforms a owl:ObjectProperty ;
    rdfs:label "conforms to shape"@en, "voldoet aan shape"@nl .

def:warns a owl:ObjectProperty ;
    rdfs:label "warns on shape"@en, "waarschuwing voor shape"@nl .

def:violates a owl:ObjectProperty ;
    rdfs:label "violates shape"@en, "schendt shape"@nl .

# ----------------------------------------------------------------------------
# source: ontology/domain/admin.trig
# ----------------------------------------------------------------------------
### Open Standard Vocabularies
### Custom Namespaces (Achmea)
def:admin
    a owl:Ontology ;
    dcterms:title "Achmea Administrative Ontology"@en ;
    dcterms:created "2025-12-30"^^xsd:date ;
    owl:versionInfo "1.0.0" ;
    owl:versionIRI <https://data.achmea.nl/def/admin/1.0.0/> ;
    rdfs:comment
        "Ontology for representing organizational unit administration in the Achmea knowledge graph."@en ,
        "Ontologie voor het representeren van administratieve eenheden binnen de Achmea kennisgrafiek."@nl ;
    owl:imports
        <https://data.achmea.nl/def/core> ,
        <https://data.achmea.nl/def/provenance> .

## --- Pension Fund ---
admin:PensionFund a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Pension Fund"@en, "Pensioenfonds"@nl ;
    rdfs:comment
        "A fund that manages pension contributions and payouts."@en ,
        "Een fonds dat pensioenbijdragen en -uitkeringen beheert."@nl .

## --- Pension Fund Administration ---
admin:PensionFundAdministration a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Pension fund administration"@en, "Pensioenfondsadministratie"@nl ;
    rdfs:comment
        "An entity that manages pension schemes and funds."@en ,
        "Een entiteit die pensioenregelingen en -fondsen beheert."@nl .

def:Employer a owl:Class ;
    rdfs:subClassOf prov:Agent, prov:Entity ;
    rdfs:label "Employer"@en, "Werkgever"@nl ;
    rdfs:comment
        "Class representing an employer associated with a PensionFundAdministration and Product Services Sheet, both an entity and an agent."@en ,
        "Klasse die een werkgever vertegenwoordigt die is gekoppeld aan een Pensioenfondsadministratie en Product Dienstenblad, zowel een entiteit als een agent."@nl .

## --- Properties ---

admin:isManagedByAdministration a owl:ObjectProperty ;
    rdfs:label "is managed by administration"@en, "wordt beheerd door administratie"@nl ;
    rdfs:comment "Relates an employer to the pension fund administration that manages them."@en ;
    rdfs:domain def:Employer ;
    rdfs:range admin:PensionFundAdministration .

admin:isAdministeredByFund a owl:ObjectProperty ;
    rdfs:label "is administered by fund"@en, "wordt geadministreerd door fonds"@nl ;
    rdfs:comment "Relates a pension fund administration back to its parent pension fund."@en ;
    rdfs:domain admin:PensionFundAdministration ;
    rdfs:range admin:PensionFund .

# ----------------------------------------------------------------------------
# source: ontology/domain/catalogue.trig
# ----------------------------------------------------------------------------
### Open Standard Vocabularies
### Custom Namespaces (Achmea)
def:pdc
    a owl:Ontology ;
    dcterms:title "Achmea Product/Diensten Catalogus Ontologie"@en ;
    dcterms:created "2025-12-30"^^xsd:date ;
    owl:versionInfo "1.0.0" ;
    owl:versionIRI <https://data.achmea.nl/def/pdc/1.0.0/> ;
    rdfs:comment
        "Ontology for representing a catalogue in the Achmea knowledge graph."@en ,
        "Ontologie voor het representeren van een catalogus in de Achmea kennisgraaf."@nl ;
    owl:imports
        <https://data.achmea.nl/def/core> ,
        <https://data.achmea.nl/def/provenance> .

    # --- Classes ---
    pdc:ProductServicesCatalogue a owl:Class ;
        rdfs:subClassOf prov:Entity ;
        rdfs:label "Product Catalogue"@en, "Productcatalogus"@nl ;
        rdfs:comment
            "A collection of products and product choices offered by a pension provider."@en ,
            "Een verzameling van producten en -keuzes die aangeboden worden door een pensioenaanbieder."@nl .

    pdc:SpecificityConcept a owl:Class ;
        rdfs:subClassOf skos:Concept ;
        rdfs:label "Specificity Concept"@en, "Specificiteit Concept"@nl ;
        rdfs:comment "Specialized concepts for defining the specificity level of a product choice."@en .

    # --- Properties ---

    pdc:hasSpecificity a owl:ObjectProperty ;
        rdfs:label "specificity"@en, "specificiteit"@nl ;
        rdfs:comment "Indicates the specificity level of a catalog resource."@en ;
        rdfs:domain prov:Entity ;
        rdfs:range pdc:SpecificityConcept .

    pdc:includesChoice a owl:ObjectProperty ;
        rdfs:label "includes choice"@en ;
        rdfs:domain pdc:ProductServicesCatalogue ;
        rdfs:range products:ProductChoice .

    pdc:includesService a owl:ObjectProperty ;
        rdfs:label "includes service"@en ;
        rdfs:domain pdc:ProductServicesCatalogue ;
        rdfs:range services:Service .

    # --- Specificity Concepts ---

    pdc:SpecificityScheme a skos:ConceptScheme ;
        rdfs:label "Specificity scheme"@en, "Specificiteit schema"@nl .

    pdc:Specificity_Generic a pdc:SpecificityConcept, skos:Concept ;
        skos:inScheme pdc:SpecificityScheme ;
        skos:prefLabel "Generic"@en, "Generiek"@nl .

    pdc:Specificity_Specific a pdc:SpecificityConcept, skos:Concept ;
        skos:inScheme pdc:SpecificityScheme ;
        skos:prefLabel "Specific"@en, "Specifiek"@nl .

    pdc:Specificity_Supplementary a pdc:SpecificityConcept, skos:Concept ;
        skos:inScheme pdc:SpecificityScheme ;
        skos:prefLabel "Supplementary"@en, "Aanvullend"@nl .

# ----------------------------------------------------------------------------
# source: ontology/domain/products.trig
# ----------------------------------------------------------------------------
### Open Standard Vocabularies
### Custom Namespaces (Achmea)
def:products
    a owl:Ontology ;
    dcterms:title "Achmea Product/Diensten Catalogus Ontologie"@en ;
    dcterms:created "2025-12-30"^^xsd:date ;
    owl:versionInfo "1.0.0" ;
    owl:versionIRI <https://data.achmea.nl/def/products/1.0.0/> ;
    rdfs:comment
        "Ontology for representing product and service catalogues (PDC) in the Achmea knowledge graph."@en ,
        "Ontologie voor het representeren van product- en dienstencatalogi (PDC) in de Achmea kennisgraaf."@nl ;
    owl:imports
        <https://data.achmea.nl/def/core> ,
        <https://data.achmea.nl/def/provenance> .

# =================================================================
# 1. CORE CATALOGUE STRUCTURE
# =================================================================

products:ProductGroup a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Product Group"@en, "Productgroep"@nl ;
    rdfs:comment
        "A category of products to which a product can belong (such as 'Old age pension')"@en ,
        "Een categorie van producten waartoe een product kan behoren (zoals 'Ouderdomspensioen')."@nl .

products:Product a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    owl:disjointWith products:ProductChoice, products:ProductPackage ;
    rdfs:label "Product"@en, "Product"@nl ;
    rdfs:comment
        "A product offered by a pension provider."@en ,
        "Een product dat wordt aangeboden door een pensioenaanbieder."@nl .

# =================================================================
# 2. PRODUCT COMPONENTS & TYPES
# =================================================================

products:ProductChoice a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    owl:disjointWith products:Product, products:ProductPackage ;
    rdfs:label "Product Choice"@en, "Productkeuze"@nl ;
    rdfs:comment "Een productkeuze. Instanties van deze klasse zijn geen gemaakte keuzes, maar slechts een representatie van een aangeboden optie."@nl .

products:ProductPackage a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    owl:disjointWith products:Product, products:ProductChoice ;
    rdfs:label "Product Package"@en, "Productpakket"@nl ;
    rdfs:comment
        "A collection of product choices that is to be selected as a whole."@en ,
        "Een verzameling van productkeuzes die als geheel gekozen dient te worden."@nl .

products:ContractType a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Contract Type"@en, "Contracttype"@nl ;
    rdfs:comment
        "The type of contract to which a product choice belongs (such as 'Flexible contribution scheme')."@en ,
        "Het type contract waaronder een keuze kan vallen (zoals 'Flexibele premieregeling')."@nl .


# =================================================================
# 4. RELATIONSHIPS & PROPERTIES
# =================================================================

## --- Catalog & Product Hierarchy ---

products:belongsToProductGroup a owl:ObjectProperty ;
    rdfs:label "belongs to product group"@en, "behoort tot productgroep"@nl ;
    rdfs:comment "Relates a product to its parent category/group."@en ;
    rdfs:domain products:Product ;
    rdfs:range products:ProductGroup .

products:isChoiceForProduct a owl:ObjectProperty ;
    rdfs:label "is choice for product"@en, "is keuze voor product"@nl ;
    rdfs:comment "Relates a specific product choice back to the product it belongs to."@en ;
    rdfs:domain products:ProductChoice ;
    rdfs:range products:Product .

products:isChoiceInPackage a owl:ObjectProperty ;
    rdfs:label "is choice in package"@en, "is keuze in pakket"@nl ;
    rdfs:comment "Relates a product choice to a package it is a part of."@en ;
    rdfs:domain products:ProductChoice ;
    rdfs:range products:ProductPackage .

## --- Classification & Attributes ---

products:productBelongsToContractType a owl:ObjectProperty ;
    rdfs:label "belongs to contract type"@en, "behoort tot contracttype"@nl ;
    rdfs:comment
        "Indicates that a product choice belongs to a contract type."@en,
        "Geeft aan dat een productkeuze behoort tot een contracttype."@nl ;
    rdfs:domain products:ProductChoice ;
    rdfs:range products:ContractType .

products:hasProductSpecificity a owl:ObjectProperty ;
    rdfs:label "specificity"@en, "specificiteit"@nl ;
    rdfs:comment
        "Indicates that a product choice has a specificity level."@en ,
        "Geeft aan dat een productkeuze een specificiteitsniveau heeft."@nl ;
    rdfs:domain products:ProductChoice ;
    rdfs:range pdc:SpecificityConcept .

products:datatype a owl:ObjectProperty ;
    rdfs:label "datatype"@en, "datatype"@nl ;
    rdfs:comment
        "References the XSD datatype URI for the product choice value (e.g., xsd:string, xsd:integer, xsd:decimal). Used for type validation of observation values."@en ,
        "Verwijst naar de XSD datatype URI voor de productkeuze waarde (bijv. xsd:string, xsd:integer, xsd:decimal). Gebruikt voor typeverificatie van observatiewaarden."@nl ;
    rdfs:domain products:ProductChoice ;
    rdfs:range xsd:anyURI .

# ----------------------------------------------------------------------------
# source: ontology/domain/pds.trig
# ----------------------------------------------------------------------------
### Open Standard Vocabularies
### Custom Namespaces (Achmea)
def:pds
    a owl:Ontology ;
    dcterms:title "Achmea Product/Diensten Sheet Ontologie"@en ;
    dcterms:created "2025-12-30"^^xsd:date ;
    owl:versionInfo "1.0.0" ;
    owl:versionIRI <https://data.achmea.nl/def/pds/1.0.0/> ;
    rdfs:comment
        "Ontology for representing product and service sheets (PDS) in the Achmea knowledge graph."@en ,
        "Ontologie voor het representeren van product- en dienstensheets (PDS) in de Achmea kennisgraaf."@nl ;
    owl:imports
        <https://data.achmea.nl/def/core> ,
        <https://data.achmea.nl/def/provenance> ,
        <https://data.achmea.nl/def/admin> .

## --- Classes ---
pds:ProductServicesSheet a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Product and Services Sheet"@en, "Product en Service selectieformulier"@nl .

pds:MasterProductServicesSheet a owl:Class ;
    rdfs:subClassOf pds:ProductServicesSheet ;
    rdfs:label "Master PDS"@en, "Master selectieformulier"@nl ;
    rdfs:comment
        "The PDS defined by the pension fund administration (PFA). This serves as the basis for employer-specific selections."@en ,
        "Het PDS dat is gedefinieerd door de pensioenfondsadministratie (PFA). Dit dient als basis voor werkgeversspecifieke selecties."@nl .

pds:EmployerProductServicesSheet a owl:Class ;
    rdfs:subClassOf pds:ProductServicesSheet ;
    rdfs:label "Employer Product and Services Sheet"@en, "Werkgever Product en Service selectieformulier"@nl ;
    rdfs:comment
        "The PDS customized by an employer based on the master PDS provided by the pension fund administration (PFA)."@en ,
        "Het PDS dat is aangepast door een werkgever op basis van het master PDS dat is verstrekt door de pensioenfondsadministratie (PFA)."@nl .

pds:StatusPDSConcept a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "PDS Status"@en , "PDS Status"@nl ;
    rdfs:comment
        "Concepts representing the lifecycle status of a Product Services Sheet."@en ,
        "Concepten die de levenscyclusstatus van een Product Services Sheet vertegenwoordigen."@nl .

## --- Hierarchy of PDS ---

pds:derivedFromMaster a owl:ObjectProperty ;
    rdfs:subPropertyOf prov:wasDerivedFrom ;
    rdfs:label "derived from master"@en, "afgeleid van master"@nl ;
    rdfs:comment "Relates an employer-specific PDS to the master template it originated from."@en ;
    rdfs:domain pds:EmployerProductServicesSheet ;
    rdfs:range pds:MasterProductServicesSheet .

pds:isDefinedByAdministration a owl:ObjectProperty ;
    rdfs:label "is defined by administration"@en, "is gedefinieerd door administratie"@nl ;
    rdfs:comment "Relates a Master PDS to the Pension Fund Administration that maintains it."@en ;
    rdfs:domain pds:MasterProductServicesSheet ;
    rdfs:range admin:PensionFundAdministration .


pds:belongsToEmployer a owl:ObjectProperty ;
    rdfs:label "belongs to employer"@en, "behoort bij werkgever"@nl ;
    rdfs:comment "Relates an Employer PDS back to the Employer it applies to."@en ;
    rdfs:domain pds:EmployerProductServicesSheet ;
    rdfs:range def:Employer .

pds:basedOnCatalogue a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "based on catalogue"@en, "gebaseerd op catalogus"@nl ;
    rdfs:comment
        "Links a Product Services Sheet to the Product Services Catalogue it is based on. This enables the PDS to know the complete list of available product choices and services."@en ,
        "Koppelt een Product Services Sheet aan de Product Services Catalogus waar het op gebaseerd is. Dit maakt het mogelijk om de volledige lijst van beschikbare productkeuzes en diensten te kennen."@nl ;
    rdfs:domain pds:ProductServicesSheet ;
    rdfs:range pdc:ProductServicesCatalogue .

## --- Properties ---

pds:status a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "status"@en, "status"@nl ;
    rdfs:domain pds:ProductServicesSheet ;
    rdfs:range pds:StatusPDSConcept ;
    rdfs:comment
        "Lifecycle status of the product sheet."@en,
        "Levenscyclusstatus van het productselectieformulier."@nl .

## --- Applying the Class ---
pds:Status_Draft a pds:StatusPDSConcept, skos:Concept ;
    skos:inScheme pds:StatusScheme ;
    skos:prefLabel "Draft"@en, "Concept"@nl .

pds:Status_Finalized a pds:StatusPDSConcept, skos:Concept ;
    skos:inScheme pds:StatusScheme ;
    skos:prefLabel "Finalized"@en, "Gefinaliseerd"@nl .

## --- Observation ---
pds:Observation a owl:Class ;
    rdfs:label "Observation"@en, "Observatie"@nl ;
    rdfs:subClassOf prov:Entity .

## --- Observation Properties ---

pds:refersToProductServicesSheet a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label
        "refers to product sheet"@en,
        "verwijst naar productselectieformulier"@nl ;
    rdfs:comment
        "Links an observation to exactly one product sheet by resource IRI."@en ,
        "Koppelt een observatie aan een enkele productselectieformulier via resource IRI."@nl ;
    rdfs:domain pds:Observation ;
    rdfs:range pds:ProductServicesSheet .

pds:refersToProductChoice a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "refers to product choice"@en, "verwijst naar productkeuze"@nl ;
    rdfs:comment
        "Links an observation to exactly one product choice by resource IRI."@en ,
        "Koppelt een observatie aan een enkele productkeuze via resource IRI."@nl ;
    rdfs:domain pds:Observation ;
    rdfs:range products:ProductChoice .

# ----------------------------------------------------------------------------
# source: ontology/domain/services.trig
# ----------------------------------------------------------------------------
### Open Standard Vocabularies
### Custom Namespaces (Achmea)
### Ontology Metadata
def:services
    a owl:Ontology ;
    dcterms:title "Achmea Services Ontologie"@en ;
    dcterms:created "2025-12-30"^^xsd:date ;
    owl:versionInfo "1.0.0" ;
    owl:versionIRI <https://data.achmea.nl/def/services/1.0.0/> ;
    rdfs:comment
        "Ontology for representing services in the Achmea knowledge graph."@en ,
        "Ontologie voor het representeren van diensten in de Achmea kennisgraaf."@nl ;
    owl:imports
        <https://data.achmea.nl/def/core> ,
        <https://data.achmea.nl/def/provenance> .

## --- Classes ---

services:ServicesComponent a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Component"@en, "Onderdeel"@nl ;
    rdfs:comment
        "A component of a service, such as Execution or Communication."@en ,
        "Een onderdeel van een dienst, zoals Uitvoering of Communicatie."@nl .

services:ServicesGroup a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Service Group"@en, "Dienstengroep"@nl ;
    rdfs:comment
        "A group to which a service belongs, such as Data Processing or Fund Control."@en ,
        "Een groep waartoe een dienst behoort, zoals Gegevensverwerking of Fondscontrol."@nl .

services:Service a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Service"@en, "Dienst"@nl ;
    rdfs:comment
        "A service offered in the product catalogue."@en ,
        "Een dienst aangeboden in de productcatalogus."@nl .

## --- Properties ---

### --- Service Datatype Properties ---
services:order a owl:DatatypeProperty ;
    rdfs:label "order"@en, "volgorde"@nl ;
    rdfs:comment
        "The order of the service."@en ,
        "De volgorde van de dienst."@nl ;
    rdfs:domain services:Service ;
    rdfs:range xsd:integer .

### --- Service Object Properties ---

services:isPartOfGroup a owl:ObjectProperty ;
    rdfs:label "is part of group"@en, "is onderdeel van groep"@nl ;
    rdfs:comment "Links a service to its parent group."@en ;
    rdfs:domain services:Service ;
    rdfs:range services:ServicesGroup .

services:serviceIsPartOfComponent a owl:ObjectProperty ;
    rdfs:label "Service is onderdeel van component"@nl ;
    rdfs:domain services:Service ;
    rdfs:range services:ServicesComponent .

services:serviceBelongsToContractType a owl:ObjectProperty ;
    rdfs:label "belongs to contract type"@en, "behoort tot contracttype"@nl ;
    rdfs:domain services:Service ;
    rdfs:range products:ContractType .

services:hasServiceSpecificity a owl:ObjectProperty ;
    rdfs:subPropertyOf pdc:hasSpecificity ;
    rdfs:label "service specificiteit"@nl ;
    rdfs:domain services:Service ;
    rdfs:range pdc:SpecificityConcept .

services:coupledToProductChoice a owl:ObjectProperty ;
    rdfs:label "coupled to product choice"@en, "gekoppeld aan productkeuze"@nl ;
    rdfs:comment
        "Indicates that a service is coupled to a product choice."@en ,
        "Geeft aan dat een dienst gekoppeld is aan een productkeuze."@nl ;
    rdfs:domain services:Service ;
    rdfs:range products:ProductChoice .

services:refersToService a owl:ObjectProperty ;
    rdfs:label "refers to service"@en, "verwijst naar dienst"@nl ;
    rdfs:comment
        "Indicates that an observation refers to a service."@en ,
        "Geeft aan dat een observatie verwijst naar een dienst."@nl ;
    rdfs:domain pds:Observation ;
    rdfs:range services:Service .

# ----------------------------------------------------------------------------
# source: ontology/provenance/provenance.trig
# ----------------------------------------------------------------------------
### Open Standard Vocabularies
### Custom Namespaces (Achmea)
def:provenance
    a owl:Ontology ;
    dcterms:title "Achmea provenance ontology"@en ;
    dcterms:created "2025-12-30"^^xsd:date ;
    owl:versionInfo "1.0.0" ;
    owl:versionIRI <https://data.achmea.nl/def/provenance/1.0.0> ;
    rdfs:comment
        "This ontology defines provenance concepts for Achmea data entities."@en ,
        "Deze ontologie definieert provenance-concepten voor Achmea data-entiteiten."@nl ;
    owl:imports
        <https://data.achmea.nl/def/core> ,
        <https://data.achmea.nl/def/pds> .

# --- Provenance Classes ---
prov:Organisation a owl:Class;
    rdfs:subClassOf prov:Agent ;
    rdfs:label "Organisation"@en, "Organisatie"@nl ;
    rdfs:comment "Class representing an organisation"@en .

def:AchmeaEmployee a owl:Class ;
    rdfs:subClassOf prov:Agent ;
    rdfs:label "Achmea Employee"@en, "Achmea Werknemer"@nl ;
    rdfs:comment "Class representing an employee of Achmea"@en .

prov:Entity a owl:Class ;
    rdfs:label "Entity"@en, "Entiteit"@nl ;
    rdfs:comment "Class representing an entity in the Achmea data model"@en .

prov:Agent a owl:Class ;
    rdfs:label "Agent"@en, "Agent"@nl ;
    rdfs:comment "Class representing an agent in the Achmea data model"@en .

## --- Activity Subclasses ---
prv:GenerationActivity a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Generation Activity"@en, "Generatie Activiteit"@nl .

prv:EditingActivity a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Editing Activity"@en , "Bewerkingsactiviteit"@nl .

prv:ValidationActivity a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Validation Activity"@en , "Validatie Activiteit"@nl ;
    rdfs:comment "Activity of validating data against SHACL shapes."@en .

sh:ValidationReport a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Validation Report"@en , "Validatierapport"@nl ;
    rdfs:comment "Report generated from a SHACL validation activity."@en .

sh:result a owl:ObjectProperty ;
    rdfs:domain sh:ValidationReport ;
    rdfs:range sh:ValidationResult ;
    rdfs:label "has validation result"@en , "heeft validatieresultaat"@nl ;
    rdfs:comment "Links a validation report to its individual results."@en .

sh:ValidationResult a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Validation Report"@en , "Validatierapport"@nl ;
    rdfs:comment "Report generated from a SHACL validation activity."@en .

## --- Activity Target Vocabulary ---

prv:ActivityTargetConcept a owl:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Activity Target Concept"@en, "Activiteitsdoel Concept"@nl ;
    rdfs:comment
        "A specific type of resource that can be the target of a provenance activity."@en ,
        "Een specifiek type bron dat het doel kan zijn van een provenance-activiteit."@nl .

prv:TargetScheme a skos:ConceptScheme ;
    rdfs:label "Activity target scheme"@en, "Activiteitsdoelen schema"@nl ;
    skos:note
        "Controlled vocabulary of primary resource types that an activity can target."@en ,
        "Gecontroleerde vocabulaire van primaire brontypen die een activiteit kan targeten."@nl .

prv:Target_PDS a prv:ActivityTargetConcept, skos:Concept ;
    skos:inScheme prv:TargetScheme ;
    skos:prefLabel "Product sheet (PDS)"@en , "Productselectieformulier (PDS)"@nl .

prv:Target_PDC a prv:ActivityTargetConcept, skos:Concept ;
    skos:inScheme prv:TargetScheme ;
    skos:prefLabel "Product catalogue (PDC)"@en , "Product/dienstencatalogus (PDC)"@nl .

prv:targets a owl:ObjectProperty, owl:FunctionalProperty ;
    rdfs:label "has target"@en , "heeft doel"@nl ;
    rdfs:comment "Indicates the specific type of resource the activity applies to."@en ;
    rdfs:domain prov:Activity ;
    rdfs:range prv:ActivityTargetConcept .

# --- Provenance Properties ---
prov:generated a owl:ObjectProperty ;
    rdfs:domain prov:Activity ;
    rdfs:range prov:Entity .

prov:invalidated a owl:ObjectProperty ;
    rdfs:domain prov:Activity ;
    rdfs:range prov:Entity .

prov:wasRevisionOf a owl:ObjectProperty ;
    rdfs:domain prov:Entity ;
    rdfs:range prov:Entity .

prov:wasStartedBy a owl:ObjectProperty ;
    rdfs:domain prov:Activity ;
    rdfs:range prov:Agent .

prov:startedAtTime a owl:DatatypeProperty ;
    rdfs:domain prov:Activity ;
    rdfs:range xsd:dateTime .

prov:endedAtTime a owl:DatatypeProperty ;
    rdfs:domain prov:Activity ;
    rdfs:range xsd:dateTime .

prov:wasAttributedTo a owl:ObjectProperty ;
    rdfs:domain prov:Entity ;
    rdfs:range prov:Agent .

prov:generatedAtTime a owl:DatatypeProperty ;
    rdfs:domain prov:Entity ;
    rdfs:range xsd:dateTime .

prov:invalidatedAtTime a owl:DatatypeProperty ;
    rdfs:domain prov:Entity ;
    rdfs:range xsd:dateTime .

prov:actedOnBehalfOf a owl:ObjectProperty ;
    rdfs:domain def:AchmeaEmployee ;
    rdfs:range prov:Organisation.

prov:used a owl:ObjectProperty ;
    rdfs:label "used"@en, "gebruikte"@nl ;
    rdfs:comment
        "Usage is the beginning of utilizing an entity by an activity. Before usage, the activity had not begun to utilize this entity and could not have been affected by the entity."@en ,
        "Gebruik is het begin van het gebruiken van een entiteit door een activiteit. Voor gebruik was de activiteit nog niet begonnen met het gebruiken van deze entiteit en kon er niet door worden beïnvloed."@nl ;
    rdfs:domain prov:Activity ;
    rdfs:range prov:Entity .

prov:value a owl:DatatypeProperty ;
    rdfs:label "value"@en, "waarde"@nl ;
    rdfs:comment
        "The literal value of the observation."@en ,
        "De letterlijke waarde van de observatie."@nl ;
    rdfs:domain pds:Observation ;
    rdfs:range rdfs:Literal .

}  # end graph:ontology


# #############################################################################
# SHACL GRAPH     <https://data.achmea.nl/graph/shacl>
# #############################################################################

graph:shacl {

# ----------------------------------------------------------------------------
# source: ontology/shacl/logic_core.trig
# ----------------------------------------------------------------------------
### Open Standard Vocabularies
### Custom Namespaces (Achmea)
def:shacl_core_validation
    a owl:Ontology ;
    dcterms:title "Core SHACL Validation Shapes - Achmea Data Ecosystem"@en ;
    dcterms:created "2025-12-30"^^xsd:date ;
    owl:versionInfo "1.0.0" ;
    owl:versionIRI <https://data.achmea.nl/def/shacl_core_validation/1.0.0/> ;
    rdfs:comment
        "This file contains core SHACL shapes for data integrity, structure validation, and business rule enforcement across all Achmea ontologies."@en ,
        "Dit bestand bevat kernachtige SHACL-shapes voor gegevensintegriteit, structuurvalidatie en bedrijfsregelhandhaving in alle Achmea-ontologieën."@nl ;
    owl:imports
        <https://data.achmea.nl/def/core> ,
        <https://data.achmea.nl/def/provenance> ,
        <https://data.achmea.nl/def/pdc> ,
        <https://data.achmea.nl/def/pds> ,
        <https://data.achmea.nl/def/services> .

# --- Shared SPARQL Prefix Declarations ---
# These prefixes are reused across all SPARQL constraints in this file
shp:prefixDeclarations
    sh:declare [ sh:prefix "def" ; sh:namespace "https://data.achmea.nl/def/"^^xsd:anyURI ] ,
               [ sh:prefix "products" ; sh:namespace "https://data.achmea.nl/def/products/"^^xsd:anyURI ] ,
               [ sh:prefix "pdc" ; sh:namespace "https://data.achmea.nl/def/pdc/"^^xsd:anyURI ] ,
               [ sh:prefix "pds" ; sh:namespace "https://data.achmea.nl/def/pds/"^^xsd:anyURI ] ,
               [ sh:prefix "services" ; sh:namespace "https://data.achmea.nl/def/services/"^^xsd:anyURI ] ,
               [ sh:prefix "prov" ; sh:namespace "http://www.w3.org/ns/prov#"^^xsd:anyURI ] ,
               [ sh:prefix "prv" ; sh:namespace "https://data.achmea.nl/def/provenance/"^^xsd:anyURI ] ,
               [ sh:prefix "rdf" ; sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ] ,
               [ sh:prefix "rdfs" ; sh:namespace "http://www.w3.org/2000/01/rdf-schema#"^^xsd:anyURI ] ,
               [ sh:prefix "owl" ; sh:namespace "http://www.w3.org/2002/07/owl#"^^xsd:anyURI ] ,
               [ sh:prefix "skos" ; sh:namespace "http://www.w3.org/2004/02/skos/core#"^^xsd:anyURI ] .

# ========================================
# VITAL SHACL SHAPES - CRITICAL DATA QUALITY
# ========================================
# These shapes enforce essential field validation and cannot be empty or contain only whitespace.

# --- Checks that identifiers are non-empty and properly formatted ---
# Ensures all critical entities have valid, non-empty identifier values.
shp:IdentifierNotEmptyShape a sh:PropertyShape ;
    sh:targetClass products:Product, products:ProductPackage, products:ProductChoice, services:Service ;
    sh:path def:identifier ;
    sh:minCount 1 ;
    sh:minLength 1 ;
    sh:maxLength 200 ;
    sh:pattern "^\\S.*\\S$|^\\S$" ;
    sh:flags "s" ;
    sh:severity sh:Violation ;
    sh:message
        "Identifier is missing or blank. Enter a non-empty identifier (≤200 chars)."@en ,
        "Identificatie ontbreekt of is leeg. Geef een niet-lege identifier (≤200 tekens)."@nl .

# --- Checks that labels exist and are properly formatted ---
# Ensures all displayed names and labels are complete and non-empty.
shp:LabelNotEmptyShape a sh:PropertyShape ;
    sh:targetClass
        pdc:ProductServicesCatalogue, products:ProductGroup, products:ContractType, products:ProductPackage,
        products:Product, products:ProductChoice, admin:PensionFund, admin:PensionFundAdministration,
        pds:ProductServicesSheet, def:Employer, services:Service, services:ServicesComponent, services:ServicesGroup ;
    sh:path def:label ;
    sh:datatype rdf:langString ;
    sh:minCount 1 ;
    sh:minLength 1 ;
    sh:maxLength 255 ;
    sh:pattern "^\\S.*\\S$|^\\S$" ;
    sh:flags "s" ;
    sh:severity sh:Violation ;
    sh:message
        "Name is missing or blank. Provide a non-empty name (≤255 chars)."@en ,
        "Naam ontbreekt of is leeg. Geef een niet-lege naam (≤255 tekens)."@nl .

# --- Checks that descriptions are meaningful when provided ---
# Service descriptions should not be empty or contain only whitespace.
shp:DescriptionNotEmptyShape a sh:PropertyShape ;
    sh:targetClass services:Service ;
    sh:path def:description ;
    sh:minCount 1 ;
    sh:minLength 1 ;
    sh:maxLength 2048 ;
    sh:pattern ".*\\S.*" ;
    sh:severity sh:Violation ;
    sh:message
        "Description is missing or blank. Add a meaningful description (≤2048 chars)."@en ,
        "Beschrijving ontbreekt of is leeg. Voeg een duidelijke beschrijving toe (≤2048 tekens)."@nl .

# --- Checks that for every valid (non-invalidated) entity, any entity it links to is also valid.
# pdc:ProductServicesCatalogue is excluded because it is a catalogue-level entity that may
# intentionally link to still-active downstream entities.
shp:ValidDownstreamShape a sh:NodeShape ;
    sh:targetClass prov:Entity ;
    sh:message
        "This item links to a retired entity. Update or remove the link so it points to a current item."@en ,
        "Dit item verwijst naar een ingetrokken entiteit. Werk de verwijzing bij of verwijder deze naar een actuele entiteit."@nl ;
    sh:severity sh:Violation ;
    sh:sparql shp:ValidDownstreamShape_sparql .

shp:ValidDownstreamShape_sparql a sh:SPARQLConstraint ;
    sh:prefixes shp:prefixDeclarations ;
    sh:message
        "Linked item is retired. Replace or remove the link to a current item."@en ,
        "Gekoppeld item is ingetrokken. Vervang of verwijder de koppeling naar een actuele entiteit."@nl ;
    sh:select """
        SELECT $this
        WHERE {
            # $this must be a prov:Entity (directly or via subclass)
            { $this a prov:Entity . }
            UNION
            { $this a ?type . ?type rdfs:subClassOf* prov:Entity . }

            # Exclude pdc:ProductServicesCatalogue — handled by shp:InvalidatedCatalogueDownstreamShape
            FILTER NOT EXISTS { $this a pdc:ProductServicesCatalogue . }

            # $this must NOT be invalidated (it is still valid)
            FILTER NOT EXISTS { $this prov:invalidatedAtTime ?invalidatedTime . }

            # $this links to ?linkedEntity which is also a prov:Entity
            $this ?p ?linkedEntity .

            # ?p cannot be prov:wasRevisionOf
            filter(?p != prov:wasRevisionOf) .

            { ?linkedEntity a prov:Entity . }
            UNION
            { ?linkedEntity a ?type2 . ?type2 rdfs:subClassOf* prov:Entity . }

            # ?linkedEntity IS invalidated — this is the violation
            ?linkedEntity prov:invalidatedAtTime ?linkedInvalidatedTime .
        }
    """ .

# --- Checks the inverse case for pdc:ProductServicesCatalogue:
# A catalogue that is itself invalidated must not link to a still-valid (non-invalidated) entity.
# This catches stale catalogue references that were not cleaned up when the catalogue was retired.
shp:InvalidatedCatalogueDownstreamShape a sh:NodeShape ;
    sh:targetClass pdc:ProductServicesCatalogue ;
    sh:message
        "This retired catalogue still links to a current item. Remove or update the link."@en ,
        "Deze ingetrokken catalogus verwijst nog naar een actueel item. Verwijder of werk de verwijzing bij."@nl ;
    sh:severity sh:Violation ;
    sh:sparql shp:InvalidatedCatalogueDownstreamShape_sparql .

shp:InvalidatedCatalogueDownstreamShape_sparql a sh:SPARQLConstraint ;
    sh:prefixes shp:prefixDeclarations ;
    sh:message
        "Retired catalogue links to an active item. Remove or retire the linked item first."@en ,
        "Ingetrokken catalogus verwijst naar een actief item. Verwijder of retireer het gekoppelde item eerst."@nl ;
    sh:select """
        SELECT $this
        WHERE {
            # $this must be a pdc:ProductServicesCatalogue
            $this a pdc:ProductServicesCatalogue .

            # $this IS invalidated
            $this prov:invalidatedAtTime ?catalogueInvalidatedTime .

            # $this links to ?linkedEntity which is also a prov:Entity
            $this ?p ?linkedEntity .
            { ?linkedEntity a prov:Entity . }
            UNION
            { ?linkedEntity a ?type2 . ?type2 rdfs:subClassOf* prov:Entity . }

            # ?linkedEntity is NOT invalidated — this is the violation
            FILTER NOT EXISTS { ?linkedEntity prov:invalidatedAtTime ?linkedInvalidatedTime . }
        }
    """ .

# ----------------------------------------------------------------------------
# source: ontology/shacl/logic_admin.trig
# ----------------------------------------------------------------------------
### Open Standard Vocabularies
### Custom Namespaces (Achmea)
def:shacl_business_logic_admin
    a owl:Ontology ;
    dcterms:title "SHACL Business Logic Validation - PROV (Provenance)"@en ;
    dcterms:created "2025-12-30"^^xsd:date ;
    owl:versionInfo "1.0.0" ;
    owl:versionIRI <https://data.achmea.nl/def/shacl_business_logic_admin/1.0.0/> ;
    rdfs:comment
        "This ontology defines SHACL shapes for PROV (Provenance) business logic validation."@en ,
        "Deze ontologie definieert SHACL-shapes voor PROV (Provenance) bedrijfslogica-validatie."@nl ;
    owl:imports
        <https://data.achmea.nl/def/core> ,
        <https://data.achmea.nl/def/admin> .

# These prefixes are reused across all SPARQL constraints in this file
shp:prefixDeclarations
    sh:declare [ sh:prefix "def" ; sh:namespace "https://data.achmea.nl/def/"^^xsd:anyURI ] ,
               [ sh:prefix "products" ; sh:namespace "https://data.achmea.nl/def/products/"^^xsd:anyURI ] ,
               [ sh:prefix "pdc" ; sh:namespace "https://data.achmea.nl/def/pdc/"^^xsd:anyURI ] ,
               [ sh:prefix "pds" ; sh:namespace "https://data.achmea.nl/def/pds/"^^xsd:anyURI ] ,
               [ sh:prefix "services" ; sh:namespace "https://data.achmea.nl/def/services/"^^xsd:anyURI ] ,
               [ sh:prefix "prov" ; sh:namespace "http://www.w3.org/ns/prov#"^^xsd:anyURI ] ,
               [ sh:prefix "prv" ; sh:namespace "https://data.achmea.nl/def/provenance/"^^xsd:anyURI ] ,
               [ sh:prefix "rdf" ; sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ] .


# --- Checks that pension fund administrations reference their parent fund ---
# Every PFA should reference the pension fund it belongs to (child -> parent).
shp:PensionFundAdministrationShape a sh:PropertyShape ;
    sh:targetClass admin:PensionFundAdministration ;
    sh:path admin:isAdministeredByFund ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class admin:PensionFund ;
    sh:severity sh:Warning ;
    sh:message
        "Specify which pension fund this administration belongs to."@en ,
        "Geef aan bij welk pensioenfonds deze administratie hoort."@nl .

shp:PensionFundAdministrationShapeViolation a sh:PropertyShape ;
    sh:targetClass admin:PensionFundAdministration ;
    sh:path admin:isAdministeredByFund ;
    sh:class admin:PensionFund ;
    sh:severity sh:Violation ;
    sh:message
        "Assign a valid parent pension fund to this administration."@en ,
        "Wijs een geldig bovenliggend pensioenfonds toe aan deze administratie."@nl .

# --- Checks that employers reference their administration ---
# Every employer should reference the PFA that manages them (child -> parent).
shp:EmployerAdministrationShape a sh:PropertyShape ;
    sh:targetClass def:Employer ;
    sh:path admin:isManagedByAdministration ;
    sh:minCount 1 ;
    sh:class admin:PensionFundAdministration ;
    sh:severity sh:Warning ;
    sh:message
        "Add at least one pension fund administration that manages this employer."@en ,
        "Voeg minstens één pensioenfondsadministratie toe die deze werkgever beheert."@nl .

shp:EmployerAdministrationShapeViolation a sh:PropertyShape ;
    sh:targetClass def:Employer ;
    sh:path admin:isManagedByAdministration ;
    sh:class admin:PensionFundAdministration ;
    sh:severity sh:Violation ;
    sh:message
        "Provide a valid pension fund administration for this employer."@en ,
        "Geef een geldige pensioenfondsadministratie voor deze werkgever op."@nl .

# ----------------------------------------------------------------------------
# source: ontology/shacl/logic_pdc.trig
# ----------------------------------------------------------------------------
### Open Standard Vocabularies
### Custom Namespaces (Achmea)
def:shacl_business_logic_pdc
    a owl:Ontology ;
    dcterms:title "SHACL Business Logic Validation - PDC (Product Data Container)"@en ;
    dcterms:created "2025-12-30"^^xsd:date ;
    owl:versionInfo "1.0.0" ;
    owl:versionIRI <https://data.achmea.nl/def/shacl_business_logic_pdc/1.0.0/> ;
    rdfs:comment
        "This ontology defines SHACL shapes for PDC (Product Data Container) business logic validation."@en ,
        "Deze ontologie definieert SHACL-shapes voor PDC (Product Data Container) bedrijfslogica-validatie."@nl ;
    owl:imports
        <https://data.achmea.nl/def/core> ,
        <https://data.achmea.nl/def/pdc> .

# --- Shared SPARQL Prefix Declarations ---
# These prefixes are reused across all SPARQL constraints in this file
shp:prefixDeclarations
    sh:declare [ sh:prefix "def" ; sh:namespace "https://data.achmea.nl/def/"^^xsd:anyURI ] ,
               [ sh:prefix "products" ; sh:namespace "https://data.achmea.nl/def/products/"^^xsd:anyURI ] ,
               [ sh:prefix "pdc" ; sh:namespace "https://data.achmea.nl/def/pdc/"^^xsd:anyURI ] ,
               [ sh:prefix "services" ; sh:namespace "https://data.achmea.nl/def/services/"^^xsd:anyURI ] ,
               [ sh:prefix "rdf" ; sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ] .

# ========================================
# PDC-SPECIFIC VALIDATION SHAPES
# ========================================

# Placeholder for future PDC-specific SHACL shapes
# These shapes will validate rules specific to Product Data Container entities

# --- Checks that product choice data types are properly defined ---
# Data type URIs guide value validation and must not be empty.
shp:DatatypeNotEmptyShape a sh:PropertyShape ;
    sh:targetClass products:ProductChoice ;
    sh:path products:datatype ;
    sh:minLength 1 ;
    sh:pattern "^\\S.*\\S$|^\\S$" ;
    sh:severity sh:Violation ;
    sh:message
        "Datatype missing — provide a valid datatype URI"@en ,
        "Datatype ontbreekt — geef een geldige datatype-URI"@nl .

# --- Checks that each product choice belongs to exactly one product ---
# Exclusive ownership prevents ambiguous product relationships.
shp:ProductChoiceExclusiveOwnershipShape a sh:PropertyShape ;
    sh:targetClass products:ProductChoice ;
    sh:sparql shp:ProductChoiceExclusiveOwnershipShape_sparql .

shp:ProductChoiceExclusiveOwnershipShape_sparql a sh:SPARQLConstraint ;
    sh:message
        "Choice linked to multiple products — ensure it links to exactly one product"@en ,
        "Keuze gekoppeld aan meerdere producten — zorg dat deze precies aan één product is gekoppeld"@nl ;
    sh:severity sh:Violation ;
    sh:prefixes shp:prefixDeclarations ;
    sh:select """
        SELECT $this WHERE {
            $this products:isChoiceForProduct ?product .
            $this products:isChoiceForProduct ?product_2 .
            ?product a products:Product .
            ?product_2 a products:Product .
            filter not exists {
                ?product prov:invalidatedAtTime ?time .
            }
            filter not exists {
                ?product_2 prov:invalidatedAtTime ?time2 .
            }
            FILTER (?product != ?product_2)
        }
    """ .

# --- Checks that data type references use valid XSD URIs ---
# Ensures compatibility with standardized XML schema types for data validation.
shp:ValidXSDDatatypeShape a sh:PropertyShape ;
    sh:targetClass products:ProductChoice ;
    sh:path products:datatype ;
    sh:pattern "^http://www\\.w3\\.org/2001/XMLSchema#(string|int|integer|long|short|decimal|boolean|date|dateTime|double|float)$" ;
    sh:severity sh:Violation ;
    sh:message
        "Datatype must be a standard XSD URI"@en ,
        "Datatype moet een standaard XSD-URI zijn"@nl .

# --- Checks that catalogues reference services ---
# Product catalogues should include services to provide complete offerings.
shp:CatalogueIncludesServiceShape a sh:PropertyShape ;
    sh:targetClass pdc:ProductServicesCatalogue ;
    sh:path pdc:includesService ;
    sh:minCount 1 ;
    sh:class services:Service ;
    sh:severity sh:Warning ;
    sh:message
        "Add at least one Service to this catalogue to list available services"@en ,
        "Voeg minimaal één Service toe aan deze catalogus om beschikbare services te tonen"@nl .

shp:CatalogueIncludesServiceShapeViolation a sh:PropertyShape ;
    sh:targetClass pdc:ProductServicesCatalogue ;
    sh:path pdc:includesService ;
    sh:class services:Service ;
    sh:severity sh:Violation ;
    sh:message
        "Catalogue must include at least one valid Service entry"@en ,
        "Catalogus moet minimaal één geldige Service bevatten"@nl .

# --- Checks that products reference valid contract types ---
# Products must be associated with the contract context they apply to.
shp:ProductChoiceBelongsToContractTypeShapeWarning a sh:PropertyShape ;
    sh:targetClass products:ProductChoice ;
    sh:path products:productBelongsToContractType ;
    sh:minCount 1 ;
    # sh:class products:ContractType ; consciously commented this out to avoid both shapes being violated simultaneously.
    sh:severity sh:Warning ;
    sh:message
        "Add a contract type to this product choice so its applicability is clear"@en ,
        "Voeg een contracttype toe aan deze productkeuze zodat de toepasbaarheid duidelijk is"@nl .

# Products must be associated with the contract context they apply to.
shp:ProductChoiceBelongsToContractTypeShapeViolation a sh:PropertyShape ;
    sh:targetClass products:ProductChoice ;
    sh:path products:productBelongsToContractType ;
    sh:class products:ContractType ;
    sh:severity sh:Violation ;
    sh:message
        "Product choice must reference a valid contract type"@en ,
        "Productkeuze moet verwijzen naar een geldig contracttype"@nl .

# --- Checks that products belong to valid product groups ---
# Products should be categorized within product groups.
shp:ProductBelongsToProductGroupShapeWarning a sh:PropertyShape ;
    sh:targetClass products:Product ;
    sh:path products:belongsToProductGroup ;
    sh:minCount 1 ;
    sh:severity sh:Warning ;
    sh:message
        "Assign this product to a product group"@en ,
        "Wijs dit product toe aan een productgroep"@nl .

shp:ProductBelongsToProductGroupShapeViolation a sh:PropertyShape ;
    sh:targetClass products:Product ;
    sh:path products:belongsToProductGroup ;
    sh:class products:ProductGroup ;
    sh:severity sh:Violation ;
    sh:message
        "Product must reference a valid product group"@en ,
        "Product moet verwijzen naar een geldige productgroep"@nl .

# --- Checks that product choices reference valid products ---
# Product choices must be associated with a parent product.
shp:ProductChoiceIsChoiceForProductShapeWarning a sh:PropertyShape ;
    sh:targetClass products:ProductChoice ;
    sh:path products:isChoiceForProduct ;
    sh:minCount 1 ;
    sh:severity sh:Warning ;
    sh:message
        "Link this choice to its parent product so it is discoverable"@en ,
        "Koppel deze keuze aan het bijbehorende product zodat het vindbaar is"@nl .

shp:ProductChoiceIsChoiceForProductShapeViolation a sh:PropertyShape ;
    sh:targetClass products:ProductChoice ;
    sh:path products:isChoiceForProduct ;
    sh:class products:Product ;
    sh:severity sh:Violation ;
    sh:message
        "Product choice must link to a valid product"@en ,
        "Productkeuze moet gekoppeld zijn aan een geldig product"@nl .

# --- Checks that product choices reference valid product packages ---
shp:ProductChoiceIsChoiceInPackageShapeViolation a sh:PropertyShape ;
    sh:targetClass products:ProductChoice ;
    sh:path products:isChoiceInPackage ;
    sh:class products:ProductPackage ;
    sh:severity sh:Violation ;
    sh:message
        "Product choice must belong to a valid product package"@en ,
        "Productkeuze moet tot een geldig productpakket behoren"@nl .

# --- Checks that services belong to valid service groups ---
# Services should be categorized within service groups.
shp:ServiceIsPartOfGroupShapeWarning a sh:PropertyShape ;
    sh:targetClass services:Service ;
    sh:path services:isPartOfGroup ;
    sh:minCount 1 ;
    sh:severity sh:Warning ;
    sh:message
        "If categorized, assign this service to a service group"@en ,
        "Als gecategoriseerd, wijs deze service toe aan een servicegroep"@nl .

shp:ServiceIsPartOfGroupShapeViolation a sh:PropertyShape ;
    sh:targetClass services:Service ;
    sh:path services:isPartOfGroup ;
    sh:class services:ServicesGroup ;
    sh:severity sh:Violation ;
    sh:message
        "Service must belong to a valid service group"@en ,
        "Service moet tot een geldige servicegroep behoren"@nl .

# --- Checks that catalogues include valid product choices ---
# Product catalogues must reference valid product choice entities.
shp:CatalogueIncludesChoiceShapeWarning a sh:PropertyShape ;
    sh:targetClass pdc:ProductServicesCatalogue ;
    sh:path pdc:includesChoice ;
    sh:minCount 1 ;  # Catalogues must have at least one choice
    sh:severity sh:Warning ;
    sh:message
        "Add product choices to this catalogue so customers can select options"@en ,
        "Voeg productkeuzes toe aan deze catalogus zodat klanten opties kunnen selecteren"@nl .

shp:CatalogueIncludesChoiceShapeViolation a sh:PropertyShape ;
    sh:targetClass pdc:ProductServicesCatalogue ;
    sh:path pdc:includesChoice ;
    sh:class products:ProductChoice ;
    sh:severity sh:Violation ;
    sh:message
        "Catalogue must reference valid product choices"@en ,
        "Catalogus moet verwijzen naar geldige productkeuzes"@nl .

# --- Checks that contract types have available services ---
# Empty service lists provide no value to customers.
# Service must reference a ContractType via services:serviceBelongsToContractType.
shp:ContractTypeServiceShape a sh:PropertyShape ;
    sh:targetClass services:Service ;
    sh:path services:serviceBelongsToContractType ;
    sh:minCount 1 ;
    sh:class products:ContractType ;
    sh:severity sh:Warning ;
    sh:message
        "Assign at least one contract type to this service"@en ,
        "Wijs minimaal één contracttype toe aan deze service"@nl .

shp:ContractTypeServiceShapeViolation a sh:PropertyShape ;
    sh:targetClass services:Service ;
    sh:path services:serviceBelongsToContractType ;
    sh:class products:ContractType ;
    sh:severity sh:Violation ;
    sh:message
        "Service must reference a valid contract type"@en ,
        "Service moet verwijzen naar een geldig contracttype"@nl .

# --- Checks that products have one or more choices available ---
# Products without choices are incomplete offerings.
# ProductChoice must reference a Product via products:isChoiceForProduct.
shp:ProductHasChoiceShape a sh:PropertyShape ;
    sh:targetClass products:ProductChoice ;
    sh:path products:isChoiceForProduct ;
    sh:minCount 1 ;
    sh:class products:Product ;
    sh:severity sh:Warning ;
    sh:message
        "Link the product choice to a product so it can be offered"@en ,
        "Koppel de productkeuze aan een product zodat deze aangeboden kan worden"@nl .

shp:ProductHasChoiceShapeViolation a sh:PropertyShape ;
    sh:targetClass products:ProductChoice ;
    sh:path products:isChoiceForProduct ;
    sh:class products:Product ;
    sh:severity sh:Violation ;
    sh:message
        "ProductChoice must link to an existing valid product"@en ,
        "Productkeuze moet gekoppeld zijn aan een bestaand geldig product"@nl .

# --- Checks that product groups contain one or more products ---
# Groups without products have no functional purpose in the catalog.
# Product must reference a ProductGroup via products:belongsToProductGroup.
shp:ProductGroupHasProductShape a sh:PropertyShape ;
    sh:targetClass products:Product ;
    sh:path products:belongsToProductGroup ;
    sh:minCount 1 ;
    sh:class products:ProductGroup ;
    sh:severity sh:Warning;
    sh:message
        "Assign this product to at least one product group"@en ,
        "Wijs dit product aan minstens één productgroep toe"@nl .

shp:ProductGroupHasProductShapeViolation a sh:PropertyShape ;
    sh:targetClass products:Product ;
    sh:path products:belongsToProductGroup ;
    sh:class products:ProductGroup ;
    sh:severity sh:Violation ;
    sh:message
        "Product must reference an existing valid product group"@en ,
        "Product moet verwijzen naar een bestaand geldige productgroep"@nl .

# --- Checks that service components contain one or more services ---
# Components without services have no value in the service hierarchy.
shp:serviceIsPartOfComponentShape a sh:PropertyShape ;
    sh:targetClass services:Service ;
    sh:path services:serviceIsPartOfComponent ;
    sh:minCount 1 ;
    sh:class services:ServicesComponent ;
    sh:severity sh:Warning ;
    sh:message
        "Add at least one component to this service"@en ,
        "Voeg minimaal één component toe aan deze service"@nl .

shp:serviceIsPartOfComponentShapeViolation a sh:PropertyShape ;
    sh:targetClass services:Service ;
    sh:path services:serviceIsPartOfComponent ;
    sh:class services:ServicesComponent ;
    sh:severity sh:Violation ;
    sh:message
        "Service must reference a valid component"@en ,
        "Service moet verwijzen naar een geldig component"@nl .

# --- Checks that services reference valid product choice couplings ---
# Coupled choices must be real choices from the product catalog.
shp:ServiceCoupledToProductChoiceShape a sh:PropertyShape ;
    sh:targetClass services:Service ;
    sh:path services:coupledToProductChoice ;
    sh:class products:ProductChoice ;
    sh:severity sh:Violation ;
    sh:message
        "Linked product choice is invalid — select a valid product choice"@en ,
        "Gekoppelde productkeuze is ongeldig — kies een geldige productkeuze"@nl .


# --- Checks that product choices have valid specificity levels ---
# Specificity must be one of: Generic, Specific, or Supplementary.
shp:ProductChoiceSpecificityShape a sh:PropertyShape ;
    sh:targetClass products:ProductChoice ;
    sh:minCount 1 ;
    sh:path products:hasProductSpecificity ;
    sh:in ( pdc:Specificity_Generic pdc:Specificity_Specific pdc:Specificity_Supplementary ) ;
    sh:severity sh:Warning ;
    sh:message
        "Set specificity to Generic, Specific, or Supplementary"@en ,
        "Stel specificiteit in op Generic, Specific of Supplementary"@nl .

# --- Checks that product sheets have a valid status ---
# Status must be either Draft (being edited) or Finalized (ready for use).
shp:ProductServicesSheetStatusShape a sh:PropertyShape ;
    sh:targetClass pds:ProductServicesSheet ;
    sh:path pds:status ;
    sh:in ( pds:Status_Draft pds:Status_Finalized ) ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Violation ;
    sh:message
        "Set sheet status to Draft or Finalized"@en ,
        "Stel de status van het formulier in op Concept of Definitief"@nl .

# --- Checks for unique product choice identifiers within their catalog ---
# Prevents duplicate identifiers that would cause ambiguity in data references.
shp:UniqueProductChoiceIdentifierShape a sh:NodeShape ;
    sh:targetClass products:ProductChoice ;
    sh:sparql shp:UniqueProductChoiceIdentifierShape_sparql.

shp:UniqueProductChoiceIdentifierShape_sparql a sh:SPARQLConstraint ;
    sh:message
        "Duplicate identifier found — use a unique ID within this catalogue"@en ,
        "Duplicaat-ID gevonden — gebruik een unieke identifier binnen deze catalogus"@nl ;
    sh:severity sh:Violation ;
    sh:prefixes shp:prefixDeclarations ;
    sh:select """
        SELECT $this WHERE {
            $this def:identifier ?id .
            ?catalogue pdc:includesChoice $this .
            ?catalogue pdc:includesChoice ?other .
            ?other def:identifier ?id .
            FILTER ($this != ?other)
            filter not exists {
                $this prov:invalidatedAtTime ?time .
            }
            filter not exists {
                ?other prov:invalidatedAtTime ?time2 .
            }
        }
    """.

# ----------------------------------------------------------------------------
# source: ontology/shacl/logic_pds.trig
# ----------------------------------------------------------------------------
### Open Standard Vocabularies
### Custom Namespaces (Achmea)
def:shacl_business_logic_pds
    a owl:Ontology ;
    dcterms:title "SHACL Business Logic Validation - PDS (Product Data Sheet)"@en ;
    dcterms:created "2025-12-30"^^xsd:date ;
    owl:versionInfo "1.0.0" ;
    owl:versionIRI <https://data.achmea.nl/def/shacl_business_logic_pds/1.0.0/> ;
    rdfs:comment
        "This ontology defines SHACL shapes for PDS (Product Data Sheet) business logic validation."@en ,
        "Deze ontologie definieert SHACL-shapes voor PDS (Product Data Sheet) bedrijfslogica-validatie."@nl ;
    owl:imports
        <https://data.achmea.nl/def/core> ,
        <https://data.achmea.nl/def/pdc> ,
        <https://data.achmea.nl/def/pds> ,
        <https://data.achmea.nl/def/services> .

# --- Shared SPARQL Prefix Declarations ---
# These prefixes are reused across all SPARQL constraints in this file
shp:prefixDeclarations
    sh:declare [ sh:prefix "products" ; sh:namespace "https://data.achmea.nl/def/products/"^^xsd:anyURI ] ,
               [ sh:prefix "pdc" ; sh:namespace "https://data.achmea.nl/def/pdc/"^^xsd:anyURI ] ,
               [ sh:prefix "pds" ; sh:namespace "https://data.achmea.nl/def/pds/"^^xsd:anyURI ] ,
               [ sh:prefix "services" ; sh:namespace "https://data.achmea.nl/def/services/"^^xsd:anyURI ] ,
               [ sh:prefix "def" ; sh:namespace "https://data.achmea.nl/def/"^^xsd:anyURI ] ,
               [ sh:prefix "rdfs" ; sh:namespace "http://www.w3.org/2000/01/rdf-schema#"^^xsd:anyURI ] ,
               [ sh:prefix "prov" ; sh:namespace "http://www.w3.org/ns/prov#"^^xsd:anyURI ] .

# --- Checks that finalized product sheets have recorded observations ---
# Finalized sheets represent published offerings and must have observation data.
shp:FinalizedProductServicesSheetObservationShape a sh:NodeShape ;
    sh:targetClass pds:ProductServicesSheet ;
    sh:sparql shp:FinalizedProductServicesSheetObservationShape_sparql .

shp:FinalizedProductServicesSheetObservationShape_sparql a sh:SPARQLConstraint ;
    sh:message
        "Published PDS needs at least one observation."@en ,
        "Gepubliceerd PDS heeft minstens één observatie nodig."@nl ;
    sh:severity sh:Violation ;
    sh:prefixes shp:prefixDeclarations ;
    sh:select """
        SELECT $this WHERE {
            $this pds:status pds:Status_Finalized .
            FILTER NOT EXISTS { ?obs pds:refersToProductServicesSheet $this . }
            filter not exists {
                $this prov:invalidatedAtTime ?time .
            }
        }
    """ .

# --- Checks that product sheets are based on a product catalogue ---
# Every PDS must reference a PDC to know the complete list of available choices.
shp:ProductServicesSheetBasedOnCatalogueShapeWarning a sh:PropertyShape ;
    sh:targetClass pds:ProductServicesSheet ;
    sh:path pds:basedOnCatalogue ;
    sh:minCount 1 ;
    sh:severity sh:Warning ;
    sh:message
        "PDS should reference at least one product catalogue."@en ,
        "PDS moet ten minste één productcatalogus refereren."@nl .

shp:ProductServicesSheetBasedOnCatalogueShapeViolation a sh:PropertyShape ;
    sh:targetClass pds:ProductServicesSheet ;
    sh:path pds:basedOnCatalogue ;
    sh:maxCount 1 ;
    sh:class pdc:ProductServicesCatalogue ;
    sh:severity sh:Violation ;
    sh:message
        "PDS must reference at most one valid product catalogue."@en ,
        "PDS moet maximaal één geldige productcatalogus refereren."@nl .

# --- Checks that observations connect to both sheets and choices or services ---

# Violation shape for pds:refersToProductServicesSheet
shp:ObservationRefersToProductServicesSheetShapeViolation a sh:PropertyShape ;
    sh:targetClass pds:Observation ;
    sh:path pds:refersToProductServicesSheet ;
    sh:class pds:ProductServicesSheet ;
    sh:severity sh:Violation ;
    sh:message
        "Observation must reference a valid PDS."@en ,
        "Observatie moet naar een geldig PDS verwijzen."@nl .

# --- Checks that observations reference valid product choices ---
# Observations for product choices must reference valid choice entities.
shp:ObservationRefersToProductChoiceShapeWarning a sh:PropertyShape ;
    sh:targetClass pds:Observation ;
    sh:path pds:refersToProductChoice ;
    sh:minCount 0 ;  # Optional - observations can refer to services instead
    sh:severity sh:Warning ;
    sh:message
        "When recording a choice, link the observation to the corresponding product choice."@en ,
        "Bij een keuze: koppel de observatie aan de betreffende productkeuze."@nl .

shp:ObservationRefersToProductChoiceShapeViolation a sh:PropertyShape ;
    sh:targetClass pds:Observation ;
    sh:path pds:refersToProductChoice ;
    sh:class products:ProductChoice ;
    sh:severity sh:Violation ;
    sh:message
        "Observation must reference a valid product choice."@en ,
        "Observatie moet naar een geldige productkeuze verwijzen."@nl .

# --- Checks that observations reference valid services ---
# Observations for services must reference valid service entities.
shp:ObservationRefersToServiceShapeWarning a sh:PropertyShape ;
    sh:targetClass pds:Observation ;
    sh:path services:refersToService ;
    sh:minCount 0 ;  # Optional - observations can refer to product choices instead
    sh:severity sh:Warning ;
    sh:message
        "When recording a service, link the observation to the service."@en ,
        "Bij een dienst: koppel de observatie aan de betreffende dienst."@nl .

shp:ObservationRefersToServiceShapeViolation a sh:PropertyShape ;
    sh:targetClass pds:Observation ;
    sh:path services:refersToService ;
    sh:class services:Service ;
    sh:severity sh:Violation ;
    sh:message
        "Observation must reference a valid service."@en ,
        "Observatie moet naar een geldige dienst verwijzen."@nl .

shp:ObservationConnectivityShapeViolation a sh:NodeShape ;
    sh:targetClass pds:Observation ;
    sh:severity sh:Violation ;
    sh:sparql shp:ObservationConnectivityShape_sparql ;
    rdfs:label
        "Observation must connect to a PDS AND have product choice OR service connection, not both."@en ,
        "Observatie moet een PDS connectie hebben EN een productkeuze OF serviceverbinding, niet beide"@nl .

shp:ObservationConnectivityShape_sparql a sh:SPARQLConstraint ;
    sh:message
        "Observation must link to a PDS and either a service or a product choice, not both."@en ,
        "Observatie moet gekoppeld zijn aan een PDS en ofwel een dienst of productkeuze, niet beide."@nl ;
    sh:prefixes shp:prefixDeclarations ;
    sh:select """
        SELECT $this WHERE {
            # Must have ProductServicesSheet reference
            $this pds:refersToProductServicesSheet ?sheet .
            filter not exists {
                ?sheet prov:invalidatedAtTime ?invalidTime2 .
            }
            FILTER NOT EXISTS {
                $this prov:invalidatedAtTime ?invalidTime .
            }
            # Violation case 1: Has NEITHER Service NOR ProductChoice
            {
                FILTER NOT EXISTS { $this services:refersToService ?service . }
                FILTER NOT EXISTS { $this pds:refersToProductChoice ?choice . }
            }
            UNION
            # Violation case 2: Has BOTH Service AND ProductChoice
            {
                FILTER EXISTS { $this services:refersToService ?service .
                filter not exists { ?service prov:invalidatedAtTime ?time3 .} }
                FILTER EXISTS { $this pds:refersToProductChoice ?choice .
                filter not exists { ?choice prov:invalidatedAtTime ?time4 .} }
            }
        }
    """ .

# --- Checks that each product has exactly one choice selected ---
# Enforces the fundamental rule: each product can only have ONE selected choice.
# A product cannot have zero or multiple choices selected at the same time.

shp:ProductChoiceUniquenessShape a sh:NodeShape ;
    sh:targetClass pds:ProductServicesSheet ;
    sh:sparql shp:ProductChoiceUniquenessShape_sparql ;
    rdfs:label
        "Product Choice Uniqueness Validation"@en ,
        "Productkeuze Uniekheidsvalidatie"@nl ;
    rdfs:comment
        "Validates that each Product in a ProductServicesSheet has exactly one ProductChoice selected."@en ,
        "Valideert dat elk Product in een ProductDienstblad exact één Productkeuze geselecteerd heeft."@nl .

shp:ProductChoiceUniquenessShape_sparql a sh:SPARQLConstraint ;
    sh:message "Product '{?productLabel}' has {?choiceCount} choices selected; pick exactly one." ;
    sh:severity sh:Violation ;
    sh:prefixes shp:prefixDeclarations ;
    sh:select """
        SELECT $this ?productLabel (COUNT(DISTINCT ?productChoice) as ?choiceCount)
        WHERE {
            # Find product choices that reference a product and have observations in this product sheet
            ?productChoice products:isChoiceForProduct ?product .
            ?product def:label ?productLabel .

            # Count distinct product choices per product that are referenced in observations
            ?observation pds:refersToProductServicesSheet $this ;
                        pds:refersToProductChoice ?productChoice .
            filter not exists {
                ?observation prov:invalidatedAtTime ?invalidTime .
            }
        }
        GROUP BY $this ?productLabel
        HAVING (COUNT(DISTINCT ?productChoice) != 1)
    """ .

# --- Checks that product choices and services are properly coupled ---
# Prevents mixing incompatible product choices with services.
# When a service is coupled to specific product choices, you cannot use it with uncoupled choices.

shp:ProductChoiceCouplingConsistencyShape a sh:NodeShape ;
    sh:targetClass pds:Observation ;
    sh:sparql shp:ProductChoiceCouplingConsistencyShape_sparql ;
    rdfs:label
        "Product Choice Coupling Consistency"@en ,
        "Productkeuze Koppeling Consistentie"@nl ;
    rdfs:comment
        "Validates that product choices and services referenced together in observations are properly coupled."@en ,
        "Valideert dat productkeuzes en diensten die samen worden gerefereerd in observaties correct gekoppeld zijn."@nl .

shp:ProductChoiceCouplingConsistencyShape_sparql a sh:SPARQLConstraint ;
    sh:message "Product choice '{?choiceLabel}' and service '{?serviceLabel}' are not compatible." ;
    sh:severity sh:Violation ;
    sh:prefixes shp:prefixDeclarations ;
    sh:select """
        SELECT $this ?choiceLabel ?serviceLabel
        WHERE {
            # Observations that reference both a product choice and a service
            $this pds:refersToProductChoice ?choice ;
                services:refersToService ?service .

            ?choice def:label ?choiceLabel .
            ?service def:label ?serviceLabel .
            filter not exists {
                ?choice prov:invalidatedAtTime ?time .
            }
            filter not exists {
                ?service prov:invalidatedAtTime ?time2 .
            }

            # Verify that the service is coupled to a product choice
            ?service services:coupledToProductChoice ?coupledChoice .
            # Flag if the coupled choice differs from the one in the observation
            FILTER (?choice != ?coupledChoice)
        }
    """ .

# --- Checks that observation values have the correct data type ---
# Product choice observations must match their declared datatype
shp:ObservationValueValidityShape a sh:NodeShape ;
    sh:targetClass pds:Observation ;
    sh:sparql shp:ObservationValueValidityShape_sparql ;
    rdfs:label
        "Observation Value Validity"@en ,
        "Observatie Waarde Validiteit"@nl ;
    rdfs:comment
        "Validates that product choice observation values match the declared datatype."@en ,
        "Valideert dat productkeuze observatiewaarden overeenkomen met het gedeclareerde datatype."@nl .

shp:ObservationValueValidityShape_sparql a sh:SPARQLConstraint ;
    sh:message "Observation value doesn't match the required data type." ;
    sh:severity sh:Violation ;
    sh:prefixes shp:prefixDeclarations ;
    sh:select """
        SELECT $this
        WHERE {
            {
                # Case 1: Value datatype doesn't match expected type
                $this pds:refersToProductChoice ?choice .
                ?choice products:datatype ?expectedType .
                $this prov:value ?value .
                filter not exists {
                    $this prov:invalidatedAtTime ?invalidTime .
                }

                # Get actual datatype of the value
                BIND(datatype(?value) AS ?actualType)

                # Allow integer/float interchangeability
                FILTER (
                    ?actualType != ?expectedType &&
                    !(
                        (?expectedType = <http://www.w3.org/2001/XMLSchema#float> && ?actualType = <http://www.w3.org/2001/XMLSchema#integer>) ||
                        (?expectedType = <http://www.w3.org/2001/XMLSchema#integer> && ?actualType = <http://www.w3.org/2001/XMLSchema#float>) ||
                        (?expectedType = <http://www.w3.org/2001/XMLSchema#double> && ?actualType = <http://www.w3.org/2001/XMLSchema#integer>) ||
                        (?expectedType = <http://www.w3.org/2001/XMLSchema#integer> && ?actualType = <http://www.w3.org/2001/XMLSchema#double>) ||
                        (?expectedType = <http://www.w3.org/2001/XMLSchema#double> && ?actualType = <http://www.w3.org/2001/XMLSchema#float>) ||
                        (?expectedType = <http://www.w3.org/2001/XMLSchema#float> && ?actualType = <http://www.w3.org/2001/XMLSchema#double>)
                    )
                )
            }
            UNION
            {
                # Case 2: ProductChoice requires a value but observation has none
                $this pds:refersToProductChoice ?choice .
                ?choice products:datatype ?expectedType .
                FILTER NOT EXISTS { $this prov:value ?value . }
            }
        }
    """ .

# --- Checks that master product sheets reference their administration ---
# Every master PDS should reference the PFA that defines it (child -> parent).
shp:MasterProductServicesSheetAdministrationShape a sh:PropertyShape ;
    sh:targetClass pds:MasterProductServicesSheet ;
    sh:path pds:isDefinedByAdministration ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class admin:PensionFundAdministration ;
    sh:severity sh:Warning ;
    sh:message
        "Master PDS must reference its Pension Fund Administration."@en ,
        "Master PDS moet verwijzen naar de Pensioenfondsadministratie."@nl .

shp:MasterProductServicesSheetAdministrationShapeViolation a sh:PropertyShape ;
    sh:targetClass pds:MasterProductServicesSheet ;
    sh:path pds:isDefinedByAdministration ;
    sh:class admin:PensionFundAdministration ;
    sh:severity sh:Violation ;
    sh:message
        "Master PDS must reference a valid Pension Fund Administration."@en ,
        "Master PDS moet naar een geldige Pensioenfondsadministratie verwijzen."@nl .

# --- Checks that employer product sheets reference their employer ---
# Every employer PDS should reference the employer it belongs to (child -> parent).
shp:EmployerProductServicesSheetEmployerShape a sh:PropertyShape ;
    sh:targetClass pds:EmployerProductServicesSheet ;
    sh:path pds:belongsToEmployer ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:class def:Employer ;
    sh:severity sh:Warning ;
    sh:message
        "Employer PDS must reference its employer."@en ,
        "Werkgevers PDS moet naar zijn werkgever verwijzen."@nl .

shp:EmployerProductServicesSheetEmployerShapeViolation a sh:PropertyShape ;
    sh:targetClass pds:EmployerProductServicesSheet ;
    sh:path pds:belongsToEmployer ;
    sh:class def:Employer ;
    sh:severity sh:Violation ;
    sh:message
        "Employer PDS must reference a valid employer."@en ,
        "Werkgevers PDS moet naar een geldige werkgever verwijzen."@nl .

# --- Checks that employer product sheets derive from master sheets ---
# Every employer PDS should reference the master PDS it was derived from (child -> parent).
shp:EmployerProductServicesSheetDerivedFromMasterShape a sh:PropertyShape ;
    sh:targetClass pds:EmployerProductServicesSheet ;
    sh:path pds:derivedFromMaster ;
    sh:minCount 1 ;
    sh:class pds:MasterProductServicesSheet ;
    sh:severity sh:Warning ;
    sh:message
        "Employer PDS should reference its master PDS."@en ,
        "Werkgevers PDS moet naar het bijbehorende master PDS verwijzen."@nl .

shp:EmployerProductServicesSheetDerivedFromMasterShapeViolation a sh:PropertyShape ;
    sh:targetClass pds:EmployerProductServicesSheet ;
    sh:path pds:derivedFromMaster ;
    sh:class pds:MasterProductServicesSheet ;
    sh:severity sh:Violation ;
    sh:message
        "Employer PDS must reference a valid master PDS."@en ,
        "Werkgevers PDS moet naar een geldige master PDS verwijzen."@nl .

# --- Checks that employer PDS observations do not overlap with master PDS observations ---
# Employer PDSes must only have observations for different ProductChoices/Services than their master PDS.
shp:EmployerObservationsNoOverlapWithMasterShape a sh:NodeShape ;
    sh:targetClass pds:EmployerProductServicesSheet ;
    sh:sparql shp:EmployerObservationsNoOverlapWithMasterShape_sparql ;
    sh:severity sh:Violation ;
    rdfs:label
        "Employer Observations No Overlap With Master"@en ,
        "Werkgever Observaties Geen Overlap Met Master"@nl ;
    rdfs:comment
        "Validates that observations in employer PDS refer to different ProductChoices and Services than the master PDS."@en ,
        "Valideert dat observaties in werkgever PDS verwijzen naar verschillende ProductChoices en Services dan de master PDS."@nl .

shp:EmployerObservationsNoOverlapWithMasterShape_sparql a sh:SPARQLConstraint ;
    sh:message
        "Employer sheet observations must differ from the master sheet's observations."@en ,
        "Werkgeversblad observaties moeten verschillen van die van het masterblad."@nl ;
    sh:prefixes shp:prefixDeclarations ;
    sh:select """
        SELECT $this ?overlappingChoice ?overlappingService WHERE {
            # Get the master PDS that this employer PDS is derived from
            $this pds:derivedFromMaster ?masterPDS .

            # Find observations in employer PDS
            ?employerObs pds:refersToProductServicesSheet $this .

            # Find observations in master PDS
            ?masterObs pds:refersToProductServicesSheet ?masterPDS .

            # Exclude invalidated observations
            FILTER NOT EXISTS {
                { ?employerObs prov:invalidatedAtTime ?invalidTime1 }
                UNION
                { ?masterObs prov:invalidatedAtTime ?invalidTime2 }
            }

            # Check for overlapping ProductChoice references
            {
                ?employerObs pds:refersToProductChoice ?overlappingChoice .
                ?masterObs pds:refersToProductChoice ?overlappingChoice .
            }
            UNION
            # Check for overlapping Service references
            {
                ?employerObs services:refersToService ?overlappingService .
                ?masterObs services:refersToService ?overlappingService .
            }
        }
    """ .

# ----------------------------------------------------------------------------
# source: ontology/shacl/logic_prov.trig
# ----------------------------------------------------------------------------
### Open Standard Vocabularies
### Custom Namespaces (Achmea)
def:shacl_business_logic_prov
    a owl:Ontology ;
    dcterms:title "SHACL Business Logic Validation - PROV (Provenance)"@en ;
    dcterms:created "2025-12-30"^^xsd:date ;
    owl:versionInfo "1.0.0" ;
    owl:versionIRI <https://data.achmea.nl/def/shacl_business_logic_prov/1.0.0/> ;
    rdfs:comment
        "This ontology defines SHACL shapes for PROV (Provenance) business logic validation."@en ,
        "Deze ontologie definieert SHACL-shapes voor PROV (Provenance) bedrijfslogica-validatie."@nl ;
    owl:imports
        <https://data.achmea.nl/def/core> ,
        <https://data.achmea.nl/def/provenance> .

# These prefixes are reused across all SPARQL constraints in this file
shp:prefixDeclarations
    sh:declare [ sh:prefix "def" ; sh:namespace "https://data.achmea.nl/def/"^^xsd:anyURI ] ,
               [ sh:prefix "products" ; sh:namespace "https://data.achmea.nl/def/products/"^^xsd:anyURI ] ,
               [ sh:prefix "pdc" ; sh:namespace "https://data.achmea.nl/def/pdc/"^^xsd:anyURI ] ,
               [ sh:prefix "pds" ; sh:namespace "https://data.achmea.nl/def/pds/"^^xsd:anyURI ] ,
               [ sh:prefix "services" ; sh:namespace "https://data.achmea.nl/def/services/"^^xsd:anyURI ] ,
               [ sh:prefix "prov" ; sh:namespace "http://www.w3.org/ns/prov#"^^xsd:anyURI ] ,
               [ sh:prefix "prv" ; sh:namespace "https://data.achmea.nl/def/provenance/"^^xsd:anyURI ] ,
               [ sh:prefix "rdf" ; sh:namespace "http://www.w3.org/1999/02/22-rdf-syntax-ns#"^^xsd:anyURI ] ,
               [ sh:prefix "rdfs" ; sh:namespace "http://www.w3.org/2000/01/rdf-schema#"^^xsd:anyURI ] .

# --- Checks that activities have an associated agent (user/system) ---
# Ensures accountability by recording who or what initiated each action.
shp:ActivityMustHaveAgentShape a sh:NodeShape ;
    sh:targetClass prov:Activity ;
    sh:sparql shp:ActivityMustHaveAgentShape_sparql .

shp:ActivityMustHaveAgentShape_sparql a sh:SPARQLConstraint ;
    sh:message
           "Specify exactly one responsible agent (user or system) for this activity; add or remove agents so only one is recorded."@en ,
           "Geef precies één verantwoordelijke (gebruiker of systeem) op voor deze activiteit; voeg toe of verwijder zodat er slechts één is."@nl ;
    sh:severity sh:Violation ;
    sh:prefixes shp:prefixDeclarations ;
    sh:select """
        SELECT $this WHERE {
            {
                # Violation when no agent exists or the agent is not typed (or subclassed) as prov:Agent
                FILTER NOT EXISTS {
                    $this prov:wasStartedBy ?agent .
                    {
                        ?agent rdf:type prov:Agent .
                    } UNION {
                        ?agent rdf:type ?agentClass .
                        ?agentClass rdfs:subClassOf* prov:Agent .
                    }
                }
            }
            UNION
            {
                # Violation when more than one distinct agent is present
                $this prov:wasStartedBy ?agent .
                $this prov:wasStartedBy ?agent_2 .
                FILTER (?agent != ?agent_2)
                # Ensure both candidates are prov:Agent (or subclass) so we only flag multiple valid agents
                FILTER (
                    (EXISTS { ?agent rdf:type prov:Agent } || EXISTS { ?agent rdf:type ?c1 . ?c1 rdfs:subClassOf* prov:Agent })
                    &&
                    (EXISTS { ?agent_2 rdf:type prov:Agent } || EXISTS { ?agent_2 rdf:type ?c2 . ?c2 rdfs:subClassOf* prov:Agent })
                )
            }
        }
    """ .

# --- Checks that activities are properly typed as editing or generation activities ---
# Type information clarifies the nature of the provenance event.
shp:ActivityTypeShape a sh:NodeShape ;
    sh:targetClass prov:Activity ;
    sh:sparql shp:ActivityTypeShape_sparql .

shp:ActivityTypeShape_sparql a sh:SPARQLConstraint ;
    sh:message
           "Mark the activity as 'Editing' or 'Generation' to clarify its purpose."@en ,
           "Maak de activiteit 'Bewerking' of 'Generatie' om het doel te verduidelijken."@nl ;
    sh:severity sh:Violation ;
    sh:prefixes shp:prefixDeclarations ;
    sh:select """
        SELECT $this WHERE {
            # Must be typed as EditingActivity OR GenerationActivity
            FILTER NOT EXISTS {
                {$this rdf:type prv:EditingActivity .}
                UNION
                {$this rdf:type prv:GenerationActivity .}
            }
        }
    """ .

# --- Checks that temporal ordering is maintained in provenance chains ---
# Generation must occur before invalidation to maintain logical consistency.
shp:TemporalConsistencyShape a sh:NodeShape ;
    sh:targetClass prov:Entity ;
    sh:sparql shp:TemporalConsistencyShape_sparql .

shp:TemporalConsistencyShape_sparql a sh:SPARQLConstraint ;
    sh:message
           "Ensure the creation time is earlier than the invalidation time; fix timestamps."@en ,
           "Zorg dat de creatietijd vóór de ongeldigmakingstijd ligt; corrigeer tijdstempels."@nl ;
    sh:severity sh:Violation ;
    sh:prefixes shp:prefixDeclarations ;
    sh:select """
        SELECT $this
        WHERE {
            $this prov:generatedAtTime ?gen .
            $this prov:invalidatedAtTime ?inv .
            FILTER (?gen >= ?inv)
        }
    """ .

# --- Checks that activities generate valid entities ---
# Generated entities must be properly typed data objects.
shp:ActivityGeneratesEntityShape a sh:PropertyShape ;
    sh:targetClass prov:Activity ;
    sh:path prov:generated ;
    sh:class prov:Entity ;
    sh:severity sh:Violation ;
    sh:message
           "Activity references an invalid generated item; link it to a valid data entity."@en ,
           "Activiteit verwijst naar een ongeldig gegenereerd item; koppel het aan een geldig gegeven."@nl .

# --- Checks that activities invalidate valid entities ---
# Invalidated entities must exist and be properly typed.
shp:ActivityInvalidatesEntityShape a sh:PropertyShape ;
    sh:targetClass prov:Activity ;
    sh:path prov:invalidated ;
    sh:class prov:Entity ;
    sh:message
           "Activity invalidates a non-existent or invalid item; reference a valid entity."@en ,
           "Activiteit maakt een niet-bestaand of ongeldig item ongeldig; verwijs naar een geldig gegeven."@nl .

shp:EntityShape a sh:NodeShape ;
    sh:targetClass prov:Entity ;
    sh:property shp:EntityWasRevisionOfShape ;
    sh:property shp:EntityWasRevisionOfShape ;
    sh:property shp:EntityWasAttributedToShape ;
    sh:property shp:EntityMustHaveGeneratedAtTimeShape .

shp:EntityWasRevisionOfShape a sh:PropertyShape ;
    sh:path prov:wasRevisionOf ;
    sh:class prov:Entity ;
    sh:severity sh:Violation ;
    sh:message
           "This entity revises a missing or invalid previous version; reference a valid prior entity."@en ,
           "Deze entiteit herziet een ontbrekende of ongeldige vorige versie; verwijs naar een geldige eerdere entiteit."@nl .

shp:EntityWasAttributedToShape a sh:PropertyShape ;
    sh:path prov:wasAttributedTo ;
    sh:class prov:Agent ;
    sh:severity sh:Violation ;
    sh:message
           "Entity must list a valid creator (person or system); add or correct the creator."@en ,
           "Entiteit moet een geldige maker (persoon of systeem) vermelden; voeg toe of corrigeer de maker."@nl .

shp:EntityMustHaveGeneratedAtTimeShape a sh:PropertyShape ;
    sh:path prov:generatedAtTime ;
    sh:datatype xsd:dateTime ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:severity sh:Warning ;
    sh:message
           "Provide exactly one creation timestamp for this item."@en ,
           "Geef precies één creatietijdstip voor dit item."@nl .

# --- Checks that provenance chains maintain proper invalidation relationships ---
# Ensures data lineage integrity when entities are revised.
# When an entity is revised (replaced by a newer version), the previous version must be marked as invalidated.
# This prevents orphaned or "ghost" entities in the revision chain.

shp:ProvenanceChainConsistencyShape a sh:NodeShape ;
    sh:targetClass prov:Agent ;
    sh:sparql shp:ProvenanceChainConsistencyShape_sparql ;
    rdfs:label
        "Provenance Chain Consistency"@en ,
        "Provenance Keten Consistentie"@nl ;
    rdfs:comment
        "Validates that revision chains maintain proper invalidation relationships."@en ,
        "Valideert dat revisieketens juiste invalidatierelaties onderhouden."@nl .

shp:ProvenanceChainConsistencyShape_sparql a sh:SPARQLConstraint ;
    sh:message "Agent has inconsistent provenance chain - revision of entity that was not invalidated" ;
        sh:message
            "A revised item wasn't marked invalidated; mark the previous version as invalidated."@en ,
            "Een herziene entiteit is niet ongeldig gemarkeerd; markeer de vorige versie als ongeldig."@nl ;
    sh:severity sh:Violation ;
    sh:prefixes shp:prefixDeclarations ;
    sh:select """
        SELECT $this
        WHERE {
            # This agent generated an entity that is a revision of a previous entity
            $this prov:generated ?entity .
            ?entity prov:wasRevisionOf ?previousEntity .

            # The previous entity must have been invalidated
            FILTER NOT EXISTS {
                ?agent prov:invalidated ?previousEntity .
            }
        }
    """ .

shp:InvalidatedEntityMustHaveInvalidatedAtTimeShape a sh:NodeShape ;
    sh:targetClass prov:Entity ;
    sh:sparql shp:InvalidatedEntityMustHaveInvalidatedAtTimeShape_sparql ;
    sh:message
           "Invalidated items must have an invalidation timestamp; add the missing time."@en ,
           "Geïnvalideerde items moeten een ongeldigmakings-tijdstempel hebben; voeg de ontbrekende tijd toe."@nl .

shp:InvalidatedEntityMustHaveInvalidatedAtTimeShape_sparql a sh:SPARQLConstraint ;
    sh:severity sh:Violation ;
    sh:prefixes shp:prefixDeclarations ;
    sh:select """
        SELECT $this
        WHERE {
            # Check if this entity was invalidated by any activity
            ?activity prov:invalidated $this .

            # If it was invalidated, it MUST have an invalidatedAtTime timestamp
            FILTER NOT EXISTS {
                $this prov:invalidatedAtTime ?time .
            }
        }
    """ .

}  # end graph:shacl
