@prefix :       <http://example.org/kg/> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:    <http://www.w3.org/2002/07/owl#> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .
@prefix dc:     <http://purl.org/dc/elements/1.1/> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix schema: <http://schema.org/> .

# ── Ontology declaration ──────────────────────────────────────────────────────
<http://example.org/kg/>
  rdf:type owl:Ontology ;
  dc:title "Academic Knowledge Graph"@en ;
  dc:title "Akademischer Wissensgraph"@de ;
  dc:title "Graphe de connaissances académiques"@fr ;
  dct:description "A rich RDF/RDFS dataset for testing parsers and schema extraction."@en ;
  owl:versionInfo "1.0.0" .

# ── Classes ───────────────────────────────────────────────────────────────────
:Person
  rdf:type owl:Class ;
  rdfs:subClassOf foaf:Person ;
  rdfs:label "Person"@en ;
  rdfs:label "Person"@de ;
  rdfs:label "Personne"@fr ;
  rdfs:comment "A human individual."@en ;
  rdfs:comment "Eine natürliche Person."@de .

:Researcher
  rdf:type owl:Class ;
  rdfs:subClassOf :Person ;
  rdfs:label "Researcher"@en ;
  rdfs:label "Forscher"@de ;
  rdfs:label "Chercheur"@fr ;
  rdfs:comment "A person engaged in research activities."@en ;
  rdfs:comment "Eine forschende Person."@de .

:Professor
  rdf:type owl:Class ;
  rdfs:subClassOf :Researcher ;
  rdfs:label "Professor"@en ;
  rdfs:label "Professor"@de ;
  rdfs:label "Professeur"@fr ;
  rdfs:comment "A senior academic holding a professorship."@en ;
  rdfs:comment "Eine Professur innehabende Person."@de .

:AssociateProfessor
  rdf:type owl:Class ;
  rdfs:subClassOf :Researcher ;
  rdfs:label "Associate Professor"@en ;
  rdfs:label "Außerordentlicher Professor"@de ;
  rdfs:label "Maître de conférences"@fr ;
  rdfs:comment "An academic between assistant and full professor rank."@en .

:GraduateStudent
  rdf:type owl:Class ;
  rdfs:subClassOf :Person ;
  rdfs:label "Graduate Student"@en ;
  rdfs:label "Doktorand"@de ;
  rdfs:label "Doctorant"@fr ;
  rdfs:comment "A student enrolled in a postgraduate programme."@en ;
  rdfs:comment "Eine in ein Doktoratsprogramm eingeschriebene Person."@de .

:Organisation
  rdf:type owl:Class ;
  rdfs:label "Organisation"@en ;
  rdfs:label "Organisation"@de ;
  rdfs:label "Organisation"@fr ;
  rdfs:comment "A social entity with a collective goal."@en .

:University
  rdf:type owl:Class ;
  rdfs:subClassOf :Organisation ;
  rdfs:label "University"@en ;
  rdfs:label "Universität"@de ;
  rdfs:label "Université"@fr ;
  rdfs:comment "A higher education and research institution."@en ;
  rdfs:comment "Eine Hochschule mit Forschungsauftrag."@de .

:ResearchGroup
  rdf:type owl:Class ;
  rdfs:subClassOf :Organisation ;
  rdfs:label "Research Group"@en ;
  rdfs:label "Forschungsgruppe"@de ;
  rdfs:label "Groupe de recherche"@fr ;
  rdfs:comment "A group of researchers collaborating on common topics."@en .

:Publication
  rdf:type owl:Class ;
  rdfs:label "Publication"@en ;
  rdfs:label "Publikation"@de ;
  rdfs:label "Publication"@fr ;
  rdfs:comment "A document disseminating research findings."@en .

:JournalArticle
  rdf:type owl:Class ;
  rdfs:subClassOf :Publication ;
  rdfs:label "Journal Article"@en ;
  rdfs:label "Zeitschriftenartikel"@de ;
  rdfs:label "Article de revue"@fr ;
  rdfs:comment "A peer-reviewed article published in a scientific journal."@en .

:ConferencePaper
  rdf:type owl:Class ;
  rdfs:subClassOf :Publication ;
  rdfs:label "Conference Paper"@en ;
  rdfs:label "Konferenzbeitrag"@de ;
  rdfs:label "Article de conférence"@fr ;
  rdfs:comment "A paper presented at a scientific conference."@en .

:ResearchProject
  rdf:type owl:Class ;
  rdfs:label "Research Project"@en ;
  rdfs:label "Forschungsprojekt"@de ;
  rdfs:label "Projet de recherche"@fr ;
  rdfs:comment "A funded investigation into a research question."@en .

:ResearchTopic
  rdf:type owl:Class ;
  rdfs:label "Research Topic"@en ;
  rdfs:label "Forschungsthema"@de ;
  rdfs:label "Thème de recherche"@fr ;
  rdfs:comment "An area or subject of scholarly investigation."@en .

# ── Data properties ───────────────────────────────────────────────────────────
:name
  rdf:type owl:DatatypeProperty ;
  rdfs:subPropertyOf foaf:name ;
  rdfs:domain :Person ;
  rdfs:range xsd:string ;
  rdfs:label "name"@en ;
  rdfs:label "Name"@de ;
  rdfs:comment "Full name of the person."@en .

:email
  rdf:type owl:DatatypeProperty ;
  rdfs:domain foaf:Person ;
  rdfs:range xsd:string ;
  rdfs:label "email"@en ;
  rdfs:label "E-Mail"@de ;
  rdfs:comment "Electronic mail address."@en .

:birthDate
  rdf:type owl:DatatypeProperty ;
  rdfs:domain :Person ;
  rdfs:range xsd:date ;
  rdfs:label "birth date"@en ;
  rdfs:label "Geburtsdatum"@de ;
  rdfs:comment "The date on which the person was born."@en .

:hIndex
  rdf:type owl:DatatypeProperty ;
  rdfs:domain :Researcher ;
  rdfs:range xsd:nonNegativeInteger ;
  rdfs:label "h-index"@en ;
  rdfs:label "h-Index"@de ;
  rdfs:comment "Hirsch index measuring scholarly impact."@en .

:citationCount
  rdf:type owl:DatatypeProperty ;
  rdfs:domain :Researcher ;
  rdfs:range xsd:nonNegativeInteger ;
  rdfs:label "citation count"@en ;
  rdfs:label "Zitierungsanzahl"@de ;
  rdfs:comment "Total number of citations received."@en .

:orcid
  rdf:type owl:DatatypeProperty ;
  rdfs:domain :Researcher ;
  rdfs:range xsd:string ;
  rdfs:label "ORCID"@en ;
  rdfs:comment "Open Researcher and Contributor ID."@en .

:publicationYear
  rdf:type owl:DatatypeProperty ;
  rdfs:domain :Publication ;
  rdfs:range xsd:gYear ;
  rdfs:label "publication year"@en ;
  rdfs:label "Erscheinungsjahr"@de ;
  rdfs:comment "Year the publication was issued."@en .

:doi
  rdf:type owl:DatatypeProperty ;
  rdfs:domain :Publication ;
  rdfs:range xsd:string ;
  rdfs:label "DOI"@en ;
  rdfs:comment "Digital Object Identifier."@en .

:pageCount
  rdf:type owl:DatatypeProperty ;
  rdfs:domain :Publication ;
  rdfs:range xsd:positiveInteger ;
  rdfs:label "page count"@en ;
  rdfs:label "Seitenanzahl"@de ;
  rdfs:comment "Number of pages in the publication."@en .

:startDate
  rdf:type owl:DatatypeProperty ;
  rdfs:domain :ResearchProject ;
  rdfs:range xsd:date ;
  rdfs:label "start date"@en ;
  rdfs:label "Startdatum"@de .

:endDate
  rdf:type owl:DatatypeProperty ;
  rdfs:domain :ResearchProject ;
  rdfs:range xsd:date ;
  rdfs:label "end date"@en ;
  rdfs:label "Enddatum"@de .

:fundingAmount
  rdf:type owl:DatatypeProperty ;
  rdfs:domain :ResearchProject ;
  rdfs:range xsd:decimal ;
  rdfs:label "funding amount"@en ;
  rdfs:label "Förderungsbetrag"@de ;
  rdfs:comment "Total funding awarded in EUR."@en .

# ── Object properties ─────────────────────────────────────────────────────────
:affiliatedWith
  rdf:type owl:ObjectProperty ;
  rdfs:domain :Person ;
  rdfs:range :Organisation ;
  rdfs:label "affiliated with"@en ;
  rdfs:label "affiliiert mit"@de ;
  rdfs:comment "Organisation the person is formally affiliated with."@en .

:supervisedBy
  rdf:type owl:ObjectProperty ;
  rdfs:domain :GraduateStudent ;
  rdfs:range :Researcher ;
  rdfs:label "supervised by"@en ;
  rdfs:label "betreut von"@de .

:authorOf
  rdf:type owl:ObjectProperty ;
  rdfs:domain :Person ;
  rdfs:range :Publication ;
  rdfs:label "author of"@en ;
  rdfs:label "Autor von"@de .

:cites
  rdf:type owl:ObjectProperty ;
  rdfs:domain :Publication ;
  rdfs:range :Publication ;
  rdfs:label "cites"@en ;
  rdfs:label "zitiert"@de .

:partOf
  rdf:type owl:ObjectProperty ;
  rdfs:domain :ResearchGroup ;
  rdfs:range :University ;
  rdfs:label "part of"@en ;
  rdfs:label "Teil von"@de .

:worksOn
  rdf:type owl:ObjectProperty ;
  rdfs:domain :Person ;
  rdfs:range :ResearchProject ;
  rdfs:label "works on"@en ;
  rdfs:label "arbeitet an"@de .

:knows
  rdf:type owl:ObjectProperty, owl:SymmetricProperty ;
  rdfs:subPropertyOf foaf:knows ;
  rdfs:domain :Person ;
  rdfs:range :Person ;
  rdfs:label "knows"@en ;
  rdfs:label "kennt"@de .

:memberOf
  rdf:type owl:ObjectProperty ;
  rdfs:domain :Person ;
  rdfs:range :ResearchGroup ;
  rdfs:label "member of"@en ;
  rdfs:label "Mitglied von"@de .

:addressedIn
  rdf:type owl:ObjectProperty ;
  rdfs:domain :ResearchTopic ;
  rdfs:range :Publication ;
  rdfs:label "addressed in"@en ;
  rdfs:label "behandelt in"@de .

:fundedBy
  rdf:type owl:ObjectProperty ;
  rdfs:domain :ResearchProject ;
  rdfs:range :Organisation ;
  rdfs:label "funded by"@en ;
  rdfs:label "finanziert von"@de .

