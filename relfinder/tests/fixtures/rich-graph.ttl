# ── Research groups ───────────────────────────────────────────────────────────
:KGLab
  rdf:type :ResearchGroup ;
  rdfs:label "Knowledge Graph Lab"@en ;
  rdfs:label "Wissensgraphen-Labor"@de ;
  rdfs:label "Laboratoire de graphes de connaissances"@fr ;
  :partOf :MIT ;
  dct:description "Research group focusing on knowledge representation and reasoning."@en .

:NLPGroup
  rdf:type :ResearchGroup ;
  rdfs:label "Natural Language Processing Group"@en ;
  rdfs:label "Gruppe für natürliche Sprachverarbeitung"@de ;
  rdfs:label "Groupe de traitement du langage naturel"@fr ;
  :partOf :Stanford ;
  dct:description "Research group advancing NLP methods and applications."@en .

:SWGroup
  rdf:type :ResearchGroup ;
  rdfs:label "Semantic Web Group"@en ;
  rdfs:label "Semantisches Web Gruppe"@de ;
  rdfs:label "Groupe Web sémantique"@fr ;
  :partOf :TUMunich ;
  dct:description "Forschungsgruppe für semantische Web-Technologien."@de .

# ── Research topics ───────────────────────────────────────────────────────────
:KnowledgeRepresentation
  rdf:type :ResearchTopic ;
  rdfs:label "Knowledge Representation"@en ;
  rdfs:label "Wissensrepräsentation"@de ;
  rdfs:label "Représentation des connaissances"@fr ;
  skos:definition "Study of how knowledge can be represented for use by AI systems."@en ;
  skos:definition "Studie zur Darstellung von Wissen für KI-Systeme."@de .

:MachineLearning
  rdf:type :ResearchTopic ;
  rdfs:label "Machine Learning"@en ;
  rdfs:label "Maschinelles Lernen"@de ;
  rdfs:label "Apprentissage automatique"@fr ;
  skos:definition "A subfield of AI enabling systems to learn from data."@en ;
  skos:definition "Teilgebiet der KI, das Systemen ermöglicht, aus Daten zu lernen."@de .

:SemanticWeb
  rdf:type :ResearchTopic ;
  rdfs:label "Semantic Web"@en ;
  rdfs:label "Semantisches Web"@de ;
  rdfs:label "Web sémantique"@fr ;
  skos:definition "Extension of the Web enabling machine-readable data."@en ;
  skos:definition "Erweiterung des Webs für maschinenlesbare Daten."@de .

:NaturalLanguageProcessing
  rdf:type :ResearchTopic ;
  rdfs:label "Natural Language Processing"@en ;
  rdfs:label "Natürliche Sprachverarbeitung"@de ;
  rdfs:label "Traitement automatique du langage naturel"@fr ;
  skos:definition "Branch of AI concerned with human language."@en ;
  skos:definition "KI-Zweig zur Verarbeitung menschlicher Sprache."@de .

