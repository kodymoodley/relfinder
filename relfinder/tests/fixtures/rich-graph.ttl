# ── Publications ──────────────────────────────────────────────────────────────
:ArticleKGSurvey2022
  rdf:type :JournalArticle ;
  rdfs:label "A Survey of Knowledge Graph Techniques"@en ;
  dc:title "A Survey of Knowledge Graph Techniques"@en ;
  :publicationYear "2022"^^xsd:gYear ;
  :doi "10.1234/kg-survey-2022" ;
  :pageCount "24"^^xsd:positiveInteger ;
  dct:abstract "This paper surveys techniques for knowledge graph construction, completion, and querying across multiple domains."@en .

:ArticleNLPNeural2021
  rdf:type :JournalArticle ;
  rdfs:label "Neural Approaches to NLP"@en ;
  dc:title "Neural Approaches to Natural Language Processing"@en ;
  :publicationYear "2021"^^xsd:gYear ;
  :doi "10.1234/nlp-neural-2021" ;
  :pageCount "18"^^xsd:positiveInteger ;
  dct:abstract "We examine neural network architectures for natural language understanding tasks."@en .

:PaperSWReasoning2023
  rdf:type :ConferencePaper ;
  rdfs:label "Reasoning over Semantic Web Data"@en ;
  dc:title "Scalable Reasoning over Semantic Web Data"@en ;
  :publicationYear "2023"^^xsd:gYear ;
  :doi "10.1234/sw-reasoning-2023" ;
  :pageCount "12"^^xsd:positiveInteger ;
  dct:abstract "We present scalable reasoning algorithms for large-scale RDF data."@en .

:ArticleML4KG2022
  rdf:type :JournalArticle ;
  rdfs:label "Machine Learning for Knowledge Graphs"@en ;
  dc:title "Machine Learning for Knowledge Graphs"@en ;
  :publicationYear "2022"^^xsd:gYear ;
  :doi "10.1234/ml4kg-2022" ;
  :pageCount "30"^^xsd:positiveInteger ;
  dct:abstract "An overview of ML techniques applied to knowledge graph embedding and completion."@en .

:PaperOntAlign2023
  rdf:type :ConferencePaper ;
  rdfs:label "Ontology Alignment with Neural Networks"@en ;
  dc:title "Ontology Alignment with Neural Networks"@en ;
  :publicationYear "2023"^^xsd:gYear ;
  :doi "10.1234/ont-align-2023" ;
  :pageCount "9"^^xsd:positiveInteger ;
  dct:abstract "We leverage neural networks to solve the ontology alignment problem at scale."@en .

:ArticleRDFQuery2020
  rdf:type :JournalArticle ;
  rdfs:label "Optimising SPARQL Query Execution"@en ;
  dc:title "Optimising SPARQL Query Execution"@en ;
  :publicationYear "2020"^^xsd:gYear ;
  :doi "10.1234/sparql-opt-2020" ;
  :pageCount "22"^^xsd:positiveInteger ;
  dct:abstract "Techniques for efficient SPARQL query evaluation over distributed RDF stores."@en .

:ArticleGNN2021
  rdf:type :JournalArticle ;
  rdfs:label "Graph Neural Networks for Link Prediction"@en ;
  dc:title "Graph Neural Networks for Link Prediction"@en ;
  :publicationYear "2021"^^xsd:gYear ;
  :doi "10.1234/gnn-link-2021" ;
  :pageCount "15"^^xsd:positiveInteger ;
  dct:abstract "A comprehensive study of GNN architectures for predicting missing links in graphs."@en .

:PaperOntEval2022
  rdf:type :ConferencePaper ;
  rdfs:label "Benchmarking Ontology Matching Systems"@en ;
  dc:title "Benchmarking Ontology Matching Systems"@en ;
  :publicationYear "2022"^^xsd:gYear ;
  :doi "10.1234/ont-bench-2022" ;
  :pageCount "8"^^xsd:positiveInteger ;
  dct:abstract "We introduce a new benchmark for evaluating ontology matching systems."@en .

