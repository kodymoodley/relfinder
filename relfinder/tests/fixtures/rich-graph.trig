# ── Named graph: Films ────────────────────────────────────────────────────────
:films {
  :FilmInception
    rdf:type :FeatureFilm ;
    rdfs:label "Inception"@en ;
    rdfs:label "Inception"@de ;
    rdfs:label "Inception"@fr ;
    dc:title "Inception" ;
    :releaseYear "2010"^^xsd:gYear ;
    :budget "160000000.00"^^xsd:decimal ;
    :runtime "148"^^xsd:positiveInteger ;
    :imdbRating "8.8"^^xsd:decimal ;
    :directedBy :ChristopherNolan ;
    :producedBy :Warner ;
    :hasGenre :GenreScienceFiction ;
    dct:description "A thief who steals corporate secrets through dream-sharing technology."@en ;
    dct:description "Ein Dieb stiehlt Unternehmensgeheimnisse durch Traumtechnologie."@de .

  :FilmGoodwillHunting
    rdf:type :FeatureFilm ;
    rdfs:label "Good Will Hunting"@en ;
    rdfs:label "Good Will Hunting"@de ;
    rdfs:label "Will Hunting"@fr ;
    dc:title "Good Will Hunting" ;
    :releaseYear "1997"^^xsd:gYear ;
    :budget "10000000.00"^^xsd:decimal ;
    :runtime "126"^^xsd:positiveInteger ;
    :imdbRating "8.3"^^xsd:decimal ;
    :directedBy :QuentinTarantino ;
    :producedBy :Miramax ;
    :hasGenre :GenreDrama ;
    dct:description "A troubled janitor with remarkable mathematical genius."@en .

  :FilmShindlersList
    rdf:type :FeatureFilm ;
    rdfs:label "Schindler's List"@en ;
    rdfs:label "Schindlers Liste"@de ;
    rdfs:label "La Liste de Schindler"@fr ;
    dc:title "Schindler's List" ;
    :releaseYear "1993"^^xsd:gYear ;
    :budget "22000000.00"^^xsd:decimal ;
    :runtime "195"^^xsd:positiveInteger ;
    :imdbRating "9.0"^^xsd:decimal ;
    :directedBy :StevenSpielberg ;
    :producedBy :Universal ;
    :hasGenre :GenreDrama ;
    dct:description "The story of Oskar Schindler who saved over a thousand Jewish refugees."@en ;
    dct:description "Die Geschichte von Oskar Schindler, der über tausend jüdische Flüchtlinge rettete."@de .

  :FilmRashomon
    rdf:type :FeatureFilm ;
    rdfs:label "Rashomon"@en ;
    rdfs:label "Rashomon"@de ;
    rdfs:label "Rashōmon"@fr ;
    dc:title "羅生門" ;
    :releaseYear "1950"^^xsd:gYear ;
    :runtime "88"^^xsd:positiveInteger ;
    :imdbRating "8.2"^^xsd:decimal ;
    :directedBy :AkiraKurosawa ;
    :hasGenre :GenreDrama ;
    dct:description "A samurai's death is described by four witnesses who all tell different stories."@en ;
    dct:description "Der Tod eines Samurai wird von vier Zeugen unterschiedlich beschrieben."@de .

  :FilmTempest
    rdf:type :FeatureFilm ;
    rdfs:label "The Tempest"@en ;
    rdfs:label "Der Sturm"@de ;
    dc:title "The Tempest" ;
    :releaseYear "2023"^^xsd:gYear ;
    :budget "8000000.00"^^xsd:decimal ;
    :runtime "112"^^xsd:positiveInteger ;
    :imdbRating "7.4"^^xsd:decimal ;
    :directedBy :JaneParkHong ;
    :producedBy :NewLine ;
    :hasGenre :GenreDrama ;
    dct:description "A contemporary drama about displacement and identity."@en .

  :FilmUnderSkies
    rdf:type :Documentary ;
    rdfs:label "Under African Skies"@en ;
    rdfs:label "Unter afrikanischem Himmel"@de ;
    rdfs:label "Sous les cieux africains"@fr ;
    dc:title "Under African Skies" ;
    :releaseYear "2012"^^xsd:gYear ;
    :runtime "93"^^xsd:positiveInteger ;
    :imdbRating "7.9"^^xsd:decimal ;
    :directedBy :JaneParkHong ;
    :hasGenre :GenreDrama ;
    dct:description "A documentary exploring cultural exchange through music."@en .
}

# ── Named graph: Awards & Roles ───────────────────────────────────────────────
:awards {
  :OscarBestPicture :awardedTo :FilmShindlersList .
  :OscarBestDirector :awardedTo :FilmShindlersList .
  :GoldenLion :awardedTo :FilmRashomon .
  :OscarBestPicture :awardedTo :FilmGoodwillHunting .

  :MerylStreep   :starredIn :FilmGoodwillHunting .
  :MerylStreep   :starredIn :FilmShindlersList .
  :CateBlanchett :starredIn :FilmInception .
  :DenzelWashington :starredIn :FilmShindlersList .
  :KiranSingh    :starredIn :FilmTempest .
  :LeilaOmrani   :starredIn :FilmTempest .
  :LeilaOmrani   :starredIn :FilmUnderSkies .

  :MerylStreep   :knows :CateBlanchett .
  :DenzelWashington :knows :MerylStreep .
  :KiranSingh    :knows :LeilaOmrani .
}
