@prefix :     <http://filmgraph.org/> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .

# -----------------------------------------------------------------------
# ONTOLOGY — classes
# -----------------------------------------------------------------------

:Person   rdf:type owl:Class .
:Movie    rdf:type owl:Class .
:Actor    rdf:type owl:Class ; rdfs:subClassOf :Person .
:Actress  rdf:type owl:Class ; rdfs:subClassOf :Person .
:Director rdf:type owl:Class ; rdfs:subClassOf :Person .
:DP       rdf:type owl:Class ; rdfs:subClassOf :Person .
:Editor   rdf:type owl:Class ; rdfs:subClassOf :Person .
:Composer rdf:type owl:Class ; rdfs:subClassOf :Person .

# -----------------------------------------------------------------------
# ONTOLOGY — properties with rdfs:label (required for node detail panel)
# -----------------------------------------------------------------------

:actedIn        rdf:type owl:ObjectProperty  ; rdfs:label "Acted In"       ; rdfs:domain :Person   ; rdfs:range :Movie .
:directed       rdf:type owl:ObjectProperty  ; rdfs:label "Directed"       ; rdfs:domain :Director ; rdfs:range :Movie .
:shotBy         rdf:type owl:ObjectProperty  ; rdfs:label "Shot By"        ; rdfs:domain :Movie    ; rdfs:range :DP .
:editedBy       rdf:type owl:ObjectProperty  ; rdfs:label "Edited By"      ; rdfs:domain :Movie    ; rdfs:range :Editor .
:scoredBy       rdf:type owl:ObjectProperty  ; rdfs:label "Scored By"      ; rdfs:domain :Movie    ; rdfs:range :Composer .
:workedWith     rdf:type owl:ObjectProperty  ; rdfs:label "Worked With"    ; rdfs:domain :Person   ; rdfs:range :Person .
:playedRole     rdf:type owl:DatatypeProperty; rdfs:label "Played Role"    ; rdfs:domain :Person   ; rdfs:range xsd:string .
:hasTitle       rdf:type owl:DatatypeProperty; rdfs:label "Title"          ; rdfs:domain :Movie    ; rdfs:range xsd:string .
:hasYear        rdf:type owl:DatatypeProperty; rdfs:label "Year"           ; rdfs:domain :Movie    ; rdfs:range xsd:integer .
:hasName        rdf:type owl:DatatypeProperty; rdfs:label "Name"           ; rdfs:domain :Person   ; rdfs:range xsd:string .
:hasNationality rdf:type owl:DatatypeProperty; rdfs:label "Nationality"    ; rdfs:domain :Person   ; rdfs:range xsd:string .
:birthDate      rdf:type owl:DatatypeProperty; rdfs:label "Birth Date"     ; rdfs:domain :Person   ; rdfs:range xsd:date .
:birthPlace     rdf:type owl:DatatypeProperty; rdfs:label "Birth Place"    ; rdfs:domain :Person   ; rdfs:range xsd:string .
:hasGenre       rdf:type owl:DatatypeProperty; rdfs:label "Genre"          ; rdfs:domain :Movie    ; rdfs:range xsd:string .

# -----------------------------------------------------------------------
# DIRECTORS
# -----------------------------------------------------------------------

:nolan      rdf:type :Director ; rdfs:label "Christopher Nolan"  ;
            :hasName "Christopher Nolan"  ; :hasNationality "British-American" ;
            :birthDate "1970-07-30"^^xsd:date ; :birthPlace "Westminster, London, UK" .

:fincher    rdf:type :Director ; rdfs:label "David Fincher"      ;
            :hasName "David Fincher"      ; :hasNationality "American" ;
            :birthDate "1962-08-28"^^xsd:date ; :birthPlace "Denver, Colorado, USA" .

:villeneuve rdf:type :Director ; rdfs:label "Denis Villeneuve"   ;
            :hasName "Denis Villeneuve"   ; :hasNationality "Canadian" ;
            :birthDate "1967-10-03"^^xsd:date ; :birthPlace "Gentilly, Quebec, Canada" .

:mendes     rdf:type :Director ; rdfs:label "Sam Mendes"         ;
            :hasName "Sam Mendes"         ; :hasNationality "British" ;
            :birthDate "1965-08-01"^^xsd:date ; :birthPlace "Reading, Berkshire, UK" .

:iannucci   rdf:type :Director ; rdfs:label "Armando Iannucci"   ;
            :hasName "Armando Iannucci"   ; :hasNationality "British" ;
            :birthDate "1963-11-28"^^xsd:date ; :birthPlace "Glasgow, Scotland, UK" .

